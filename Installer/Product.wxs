<?xml version="1.0" encoding="UTF-8"?>
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs" xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui">

  <Package
      Name="TaskCore"
      Manufacturer="RIAUHAS"
      Version="4.4.4.0"
      UpgradeCode="{8F79B9C2-9A0C-4C7A-B5E0-6CE7C6F92A34}"
      Scope="perUser"
      Compressed="yes">

    <Media Id="1" Cabinet="cab1.cab" EmbedCab="yes" />

    <MajorUpgrade DowngradeErrorMessage="A newer version of TaskCore is already installed." />

    <!-- UI -->
    <Property Id="WIXUI_INSTALLDIR" Value="INSTALLFOLDER" />
    <ui:WixUI Id="WixUI_InstallDir" />

    <!-- Directory layout -->
    <StandardDirectory Id="LocalAppDataFolder">
      <Directory Id="INSTALLFOLDER" Name="TaskCore" />
    </StandardDirectory>

    <StandardDirectory Id="ProgramMenuFolder">
      <Directory Id="TaskCoreStartMenu" Name="TaskCore" />
    </StandardDirectory>

    <StandardDirectory Id="DesktopFolder"/>

    <!-- Features -->
    <Feature Id="MainFeature" Title="TaskCore" Level="1">
      <ComponentGroupRef Id="TaskCoreFiles" />
      <ComponentRef Id="DesktopShortcutComponent"/>
      <ComponentRef Id="StartMenuShortcutComponent"/>
    </Feature>

    <!-- Desktop Shortcut -->
    <Component Id="DesktopShortcutComponent" Directory="DesktopFolder">
      <Shortcut
         Id="DesktopShortcut"
         Name="TaskCore"
         Target="[INSTALLFOLDER]TaskCore.exe"
         WorkingDirectory="INSTALLFOLDER"/>

      <RegistryKey Root="HKCU" Key="Software\RIAUHAS\TaskCore">
        <RegistryValue Name="DesktopShortcut" Value="1" Type="integer" />
      </RegistryKey>
    </Component>

    <!-- Start Menu Shortcut -->
    <Component Id="StartMenuShortcutComponent" Directory="TaskCoreStartMenu">
      <Shortcut
         Id="StartMenuShortcut"
         Name="TaskCore"
         Target="[INSTALLFOLDER]TaskCore.exe"
         WorkingDirectory="INSTALLFOLDER"/>

      <RegistryKey Root="HKCU" Key="Software\RIAUHAS\TaskCore">
        <RegistryValue Name="StartMenuShortcut" Value="1" Type="integer" />
      </RegistryKey>

      <RemoveFile Id="RemoveStart" Directory="TaskCoreStartMenu" Name="*" On="uninstall"/>
    </Component>

  </Package>

</Wix>