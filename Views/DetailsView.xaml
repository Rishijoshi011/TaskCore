<UserControl x:Class="TaskCore.Views.DetailsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:TaskCore.ViewModels"
             xmlns:helpers="clr-namespace:TaskCore.Helpers"
             Background="{StaticResource BackgroundPrimary}"
             Padding="20">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>
        <!-- Proxy to allow DataContext binding from DataGridColumn -->
        <helpers:BindingProxy x:Key="VmProxy" Data="{Binding}"/>
    </UserControl.Resources>

    <UserControl.DataContext>
        <vm:DetailsViewModel/>
    </UserControl.DataContext>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
        <StackPanel>
            <!-- Header -->
            <TextBlock Text="Session Tracker"
                       FontSize="26"
                       FontWeight="Bold"
                       Foreground="{StaticResource AccentBrush}"
                       Margin="0 0 0 20"/>

            <!-- Controls Section -->
            <Border Style="{StaticResource CardPanel}" Margin="0 0 0 14" Padding="14">
                <StackPanel>
                    <!-- Top Row with Date, Search, and Buttons -->
                    <StackPanel Orientation="Horizontal" Margin="0 0 0 12">
                        <!-- Date Picker -->
                        <StackPanel Orientation="Vertical" Margin="0 0 12 0">
                            <TextBlock Text="Date" Foreground="{StaticResource TextSecondary}" FontSize="11" Margin="0 0 0 4"/>
                            <DatePicker SelectedDate="{Binding SelectedDate}" Width="150" Height="32" VerticalAlignment="Center" 
                                        Style="{StaticResource DarkDatePicker}" BorderThickness="0" BorderBrush="{StaticResource BackgroundSecondary}"/>
                        </StackPanel>

                        <!-- Search Box -->
                        <StackPanel Orientation="Vertical" Margin="0 0 12 0">
                            <TextBlock Text="Search" Foreground="{StaticResource TextSecondary}" FontSize="11" Margin="0 0 0 4"/>
                            <TextBox Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}" Height="38" Width="200" 
                                     Background="{StaticResource BackgroundSecondary}" Foreground="{StaticResource TextPrimary}" 
                                     BorderBrush="{StaticResource BackgroundCard}" BorderThickness="1" Padding="8,6"/>
                        </StackPanel>

                        <!-- Buttons -->
                        <StackPanel Orientation="Vertical">
                            <TextBlock Text="" Foreground="{StaticResource TextSecondary}" FontSize="11" Margin="0 0 0 4" Height="15"/>
                            <StackPanel Orientation="Horizontal">
                                <Button Content="Refresh" Command="{Binding RefreshDataCommand}" Height="32" Style="{StaticResource ActionButton}" Margin="0 0 5 0"/>
                                <Button Content="Cleanup" Command="{Binding CleanupOldDataCommand}" Height="32" Style="{StaticResource ActionButton}"/>
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>

                    <!-- Logs Directory -->
                    <StackPanel Orientation="Vertical">
                        <TextBlock Text="{Binding SessionLogsDirectory, StringFormat=Logs: {0}}"
                                   Foreground="{StaticResource TextSecondary}"
                                   FontSize="11"
                                   TextTrimming="CharacterEllipsis"
                                   Cursor="Hand"
                                   ToolTip="Double click to copy">
                            <TextBlock.InputBindings>
                                <MouseBinding MouseAction="LeftDoubleClick" Command="{Binding CopySessionLogsDirectoryCommand}"/>
                            </TextBlock.InputBindings>
                        </TextBlock>
                        <TextBlock Text="{Binding CopyStatusText}" Foreground="#22C55E" FontSize="11" Margin="0 2 0 0"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Overview Cards -->
            <UniformGrid Columns="4" Margin="0 0 0 14">
                <Border Style="{StaticResource CardPanel}" Margin="0 0 10 0" Padding="14">
                    <StackPanel>
                        <TextBlock Text="Apps" Foreground="{StaticResource TextSecondary}" FontSize="11"/>
                        <TextBlock Text="{Binding AppSummaries.Count}" Foreground="{StaticResource TextPrimary}" FontSize="20" FontWeight="Bold" Margin="0 6 0 0"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource CardPanel}" Margin="0 0 10 0" Padding="14">
                    <StackPanel>
                        <TextBlock Text="Sessions" Foreground="{StaticResource TextSecondary}" FontSize="11"/>
                        <TextBlock Text="{Binding Sessions.Count}" Foreground="{StaticResource TextPrimary}" FontSize="20" FontWeight="Bold" Margin="0 6 0 0"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource CardPanel}" Margin="0 0 10 0" Padding="14">
                    <StackPanel>
                        <TextBlock Text="Top App" Foreground="{StaticResource TextSecondary}" FontSize="11"/>
                        <TextBlock Text="{Binding TopAppName}" Foreground="{StaticResource TextPrimary}" FontSize="16" FontWeight="SemiBold" Margin="0 6 0 0" TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="{Binding TopAppSessionsText}" Foreground="{StaticResource TextSecondary}" FontSize="11"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource CardPanel}" Margin="0" Padding="14">
                    <StackPanel>
                        <TextBlock Text="Longest Session" Foreground="{StaticResource TextSecondary}" FontSize="11"/>
                        <TextBlock Text="{Binding LongestSessionText}" Foreground="{StaticResource TextPrimary}" FontSize="16" FontWeight="SemiBold" Margin="0 6 0 0"/>
                    </StackPanel>
                </Border>
            </UniformGrid>

            <!-- Export Controls -->
            <Border Style="{StaticResource CardPanel}" Margin="0 0 0 14" Padding="14">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" Text="Export Data" Foreground="{StaticResource TextPrimary}" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="From:" Foreground="{StaticResource TextSecondary}" FontSize="12" Margin="0 0 6 0" VerticalAlignment="Center"/>
                        <DatePicker SelectedDate="{Binding StartDate}" Width="120" Height="28" VerticalAlignment="Center" Style="{StaticResource DarkDatePicker}" BorderThickness="0" BorderBrush="{StaticResource BackgroundSecondary}"/>
                        <TextBlock Text="To:" Foreground="{StaticResource TextSecondary}" FontSize="12" Margin="12 0 6 0" VerticalAlignment="Center"/>
                        <DatePicker SelectedDate="{Binding EndDate}" Width="120" Height="28" VerticalAlignment="Center" Style="{StaticResource DarkDatePicker}" BorderThickness="0" BorderBrush="{StaticResource BackgroundSecondary}"/>
                    </StackPanel>

                    <Button Grid.Column="3" Content="Export CSV" Command="{Binding ExportToCsvCommand}" Height="28" Style="{StaticResource ActionButton}" Margin="10 0 5 0"/>
                    <Button Grid.Column="4" Content="Export JSON" Command="{Binding ExportToJsonCommand}" Height="28" Style="{StaticResource ActionButton}" Margin="5 0 0 0"/>
                </Grid>
            </Border>

            <TextBlock Text="App Summary" Foreground="{StaticResource TextPrimary}" FontSize="16" FontWeight="SemiBold" Margin="0 0 0 8"/>

            <Border Background="{StaticResource BackgroundCard}"
                    BorderBrush="#339A4DFF"
                    BorderThickness="4"
                    CornerRadius="10"
                    SnapsToDevicePixels="True"
                    Padding="0"
                    Margin="0 0 0 14">
                <Border.Clip>
                    <RectangleGeometry RadiusX="10" RadiusY="10" Rect="0,0,10000,10000"/>
                </Border.Clip>

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <DataGrid Grid.Row="0"
                              ItemsSource="{Binding PagedAppSummaries}"
                              Style="{StaticResource DarkDataGrid}"
                              AutoGenerateColumns="False"
                              HeadersVisibility="Column"
                              HorizontalAlignment="Stretch"
                              HorizontalContentAlignment="Stretch"
                              VerticalAlignment="Center"
                              VerticalContentAlignment="Center"
                              x:Name="AppSummaryGrid">
                        <DataGrid.ContextMenu>
                            <ContextMenu Style="{StaticResource DarkContextMenu}">
                                <MenuItem Header="Application" IsCheckable="True" IsChecked="{Binding PlacementTarget.DataContext.ShowSummaryApp, RelativeSource={RelativeSource AncestorType=ContextMenu}}" Style="{StaticResource DarkMenuItem}"/>
                                <MenuItem Header="Sessions" IsCheckable="True" IsChecked="{Binding PlacementTarget.DataContext.ShowSummarySessions, RelativeSource={RelativeSource AncestorType=ContextMenu}}" Style="{StaticResource DarkMenuItem}"/>
                                <MenuItem Header="Longest" IsCheckable="True" IsChecked="{Binding PlacementTarget.DataContext.ShowSummaryLongest, RelativeSource={RelativeSource AncestorType=ContextMenu}}" Style="{StaticResource DarkMenuItem}"/>
                                <MenuItem Header="Peak CPU %" IsCheckable="True" IsChecked="{Binding PlacementTarget.DataContext.ShowSummaryPeakCpu, RelativeSource={RelativeSource AncestorType=ContextMenu}}" Style="{StaticResource DarkMenuItem}"/>
                                <MenuItem Header="Avg CPU %" IsCheckable="True" IsChecked="{Binding PlacementTarget.DataContext.ShowSummaryAvgCpu, RelativeSource={RelativeSource AncestorType=ContextMenu}}" Style="{StaticResource DarkMenuItem}"/>
                                <MenuItem Header="Peak Memory" IsCheckable="True" IsChecked="{Binding PlacementTarget.DataContext.ShowSummaryPeakMem, RelativeSource={RelativeSource AncestorType=ContextMenu}}" Style="{StaticResource DarkMenuItem}"/>
                                <MenuItem Header="Avg Memory" IsCheckable="True" IsChecked="{Binding PlacementTarget.DataContext.ShowSummaryAvgMem, RelativeSource={RelativeSource AncestorType=ContextMenu}}" Style="{StaticResource DarkMenuItem}"/>
                            </ContextMenu>
                        </DataGrid.ContextMenu>
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Application" Binding="{Binding AppName}" Width="Auto" Visibility="{Binding Data.ShowSummaryApp, Source={StaticResource VmProxy}, Converter={StaticResource BoolToVisibility}}">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="HorizontalAlignment" Value="Center"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="Sessions" Binding="{Binding SessionCount}" Width="Auto" Visibility="{Binding Data.ShowSummarySessions, Source={StaticResource VmProxy}, Converter={StaticResource BoolToVisibility}}">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="HorizontalAlignment" Value="Center"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="Longest" Binding="{Binding LongestSessionDisplay}" Width="Auto" Visibility="{Binding Data.ShowSummaryLongest, Source={StaticResource VmProxy}, Converter={StaticResource BoolToVisibility}}">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="HorizontalAlignment" Value="Center"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="Peak CPU %" Binding="{Binding PeakCpuPercent, StringFormat={}{0:F1}}" Width="Auto" Visibility="{Binding Data.ShowSummaryPeakCpu, Source={StaticResource VmProxy}, Converter={StaticResource BoolToVisibility}}">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="HorizontalAlignment" Value="Center"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="Avg CPU %" Binding="{Binding AverageCpuPercent, StringFormat={}{0:F1}}" Width="Auto" Visibility="{Binding Data.ShowSummaryAvgCpu, Source={StaticResource VmProxy}, Converter={StaticResource BoolToVisibility}}">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="HorizontalAlignment" Value="Center"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="Peak Memory" Binding="{Binding PeakMemoryMb, StringFormat={}{0:F0} MB}" Width="Auto" Visibility="{Binding Data.ShowSummaryPeakMem, Source={StaticResource VmProxy}, Converter={StaticResource BoolToVisibility}}">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="HorizontalAlignment" Value="Center"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="Avg Memory" Binding="{Binding AverageMemoryMb, StringFormat={}{0:F0} MB}" Width="Auto" Visibility="{Binding Data.ShowSummaryAvgMem, Source={StaticResource VmProxy}, Converter={StaticResource BoolToVisibility}}">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="HorizontalAlignment" Value="Center"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                        </DataGrid.Columns>
                    </DataGrid>

                    <DockPanel Grid.Row="1" Margin="10,8,10,8" LastChildFill="False">
                        <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                            <Button Content="Prev" Command="{Binding SummaryPrevPageCommand}" Height="26" MinWidth="60" Margin="0,0,8,0" Style="{StaticResource ActionButton}"/>
                            <TextBlock Text="{Binding SummaryPageText}" Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <Button Content="Next" Command="{Binding SummaryNextPageCommand}" Height="26" MinWidth="60" Style="{StaticResource ActionButton}"/>
                        </StackPanel>
                    </DockPanel>
                </Grid>
            </Border>

            <TextBlock Text="Sessions" Foreground="{StaticResource TextPrimary}" FontSize="16" FontWeight="SemiBold" Margin="0 0 0 8"/>

            <Border Background="{StaticResource BackgroundCard}"
                    BorderBrush="#339A4DFF"
                    BorderThickness="4"
                    CornerRadius="10"
                    SnapsToDevicePixels="True"
                    Padding="0"
                    Margin="0">
                <Border.Clip>
                    <RectangleGeometry RadiusX="10" RadiusY="10" Rect="0,0,10000,10000"/>
                </Border.Clip>

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <DataGrid Grid.Row="0"
                              ItemsSource="{Binding PagedSessions}"
                              Style="{StaticResource DarkDataGrid}"
                              AutoGenerateColumns="False"
                              HeadersVisibility="Column"
                              HorizontalAlignment="Stretch"
                              HorizontalContentAlignment="Stretch"
                              VerticalAlignment="Center"
                              VerticalContentAlignment="Center"
                              x:Name="SessionsGrid">
                        <DataGrid.ContextMenu>
                            <ContextMenu Style="{StaticResource DarkContextMenu}">
                                <MenuItem Header="Application" IsCheckable="True" IsChecked="{Binding PlacementTarget.DataContext.ShowSessionApp, RelativeSource={RelativeSource AncestorType=ContextMenu}}" Style="{StaticResource DarkMenuItem}"/>
                                <MenuItem Header="PID" IsCheckable="True" IsChecked="{Binding PlacementTarget.DataContext.ShowSessionPid, RelativeSource={RelativeSource AncestorType=ContextMenu}}" Style="{StaticResource DarkMenuItem}"/>
                                <MenuItem Header="Start" IsCheckable="True" IsChecked="{Binding PlacementTarget.DataContext.ShowSessionStart, RelativeSource={RelativeSource AncestorType=ContextMenu}}" Style="{StaticResource DarkMenuItem}"/>
                                <MenuItem Header="End" IsCheckable="True" IsChecked="{Binding PlacementTarget.DataContext.ShowSessionEnd, RelativeSource={RelativeSource AncestorType=ContextMenu}}" Style="{StaticResource DarkMenuItem}"/>
                                <MenuItem Header="Duration" IsCheckable="True" IsChecked="{Binding PlacementTarget.DataContext.ShowSessionDuration, RelativeSource={RelativeSource AncestorType=ContextMenu}}" Style="{StaticResource DarkMenuItem}"/>
                                <MenuItem Header="Peak CPU %" IsCheckable="True" IsChecked="{Binding PlacementTarget.DataContext.ShowSessionPeakCpu, RelativeSource={RelativeSource AncestorType=ContextMenu}}" Style="{StaticResource DarkMenuItem}"/>
                                <MenuItem Header="Avg CPU %" IsCheckable="True" IsChecked="{Binding PlacementTarget.DataContext.ShowSessionAvgCpu, RelativeSource={RelativeSource AncestorType=ContextMenu}}" Style="{StaticResource DarkMenuItem}"/>
                                <MenuItem Header="Peak Memory" IsCheckable="True" IsChecked="{Binding PlacementTarget.DataContext.ShowSessionPeakMem, RelativeSource={RelativeSource AncestorType=ContextMenu}}" Style="{StaticResource DarkMenuItem}"/>
                                <MenuItem Header="Avg Memory" IsCheckable="True" IsChecked="{Binding PlacementTarget.DataContext.ShowSessionAvgMem, RelativeSource={RelativeSource AncestorType=ContextMenu}}" Style="{StaticResource DarkMenuItem}"/>
                            </ContextMenu>
                        </DataGrid.ContextMenu>
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Application" Binding="{Binding AppName}" Width="Auto" Visibility="{Binding Data.ShowSessionApp, Source={StaticResource VmProxy}, Converter={StaticResource BoolToVisibility}}">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="HorizontalAlignment" Value="Center"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="PID" Binding="{Binding ProcessId}" Width="Auto" Visibility="{Binding Data.ShowSessionPid, Source={StaticResource VmProxy}, Converter={StaticResource BoolToVisibility}}">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="HorizontalAlignment" Value="Center"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="Start" Binding="{Binding StartDisplay}" Width="Auto" Visibility="{Binding Data.ShowSessionStart, Source={StaticResource VmProxy}, Converter={StaticResource BoolToVisibility}}">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="HorizontalAlignment" Value="Center"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="End" Binding="{Binding EndDisplay}" Width="Auto" Visibility="{Binding Data.ShowSessionEnd, Source={StaticResource VmProxy}, Converter={StaticResource BoolToVisibility}}">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="HorizontalAlignment" Value="Center"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="Duration" Binding="{Binding DurationDisplay}" Width="Auto" Visibility="{Binding Data.ShowSessionDuration, Source={StaticResource VmProxy}, Converter={StaticResource BoolToVisibility}}">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="HorizontalAlignment" Value="Center"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="Peak CPU %" Binding="{Binding PeakCpuPercent, StringFormat={}{0:F1}}" Width="Auto" Visibility="{Binding Data.ShowSessionPeakCpu, Source={StaticResource VmProxy}, Converter={StaticResource BoolToVisibility}}">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="HorizontalAlignment" Value="Center"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="Avg CPU %" Binding="{Binding AverageCpuPercent, StringFormat={}{0:F1}}" Width="Auto" Visibility="{Binding Data.ShowSessionAvgCpu, Source={StaticResource VmProxy}, Converter={StaticResource BoolToVisibility}}">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="HorizontalAlignment" Value="Center"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="Peak Memory" Binding="{Binding PeakMemoryMb, StringFormat={}{0:F0} MB}" Width="Auto" Visibility="{Binding Data.ShowSessionPeakMem, Source={StaticResource VmProxy}, Converter={StaticResource BoolToVisibility}}">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="HorizontalAlignment" Value="Center"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="Avg Memory" Binding="{Binding AverageMemoryMb, StringFormat={}{0:F0} MB}" Width="Auto" Visibility="{Binding Data.ShowSessionAvgMem, Source={StaticResource VmProxy}, Converter={StaticResource BoolToVisibility}}">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="HorizontalAlignment" Value="Center"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                        </DataGrid.Columns>
                    </DataGrid>

                    <DockPanel Grid.Row="1" Margin="10,8,10,8" LastChildFill="False">
                        <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                            <Button Content="Prev" Command="{Binding SessionsPrevPageCommand}" Height="26" MinWidth="60" Margin="0,0,8,0" Style="{StaticResource ActionButton}"/>
                            <TextBlock Text="{Binding SessionsPageText}" Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <Button Content="Next" Command="{Binding SessionsNextPageCommand}" Height="26" MinWidth="60" Style="{StaticResource ActionButton}"/>
                        </StackPanel>
                    </DockPanel>
                </Grid>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
