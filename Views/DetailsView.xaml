<UserControl x:Class="TaskCore.Views.DetailsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:TaskCore.ViewModels"
             xmlns:helpers="clr-namespace:TaskCore.Helpers"
             Background="{StaticResource BackgroundPrimary}"
             Padding="20">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>
        <!-- Proxy to allow DataContext binding from DataGridColumn -->
        <helpers:BindingProxy x:Key="VmProxy" Data="{Binding}"/>
    </UserControl.Resources>

    <UserControl.DataContext>
        <vm:DetailsViewModel/>
    </UserControl.DataContext>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
        <StackPanel>
            <!-- Header -->
            <StackPanel Orientation="Horizontal" Margin="0 0 0 0">
                <TextBlock Text="Session Tracker"
                           FontSize="26"
                           FontWeight="Bold"
                           Foreground="{DynamicResource AccentBrush}"/>
                <Control Style="{StaticResource InfoIcon}" Margin="10 0 0 0" VerticalAlignment="Center"
                         ToolTip="Track application usage over time.&#10;View session history, export data, and analyze app activity."/>
            </StackPanel>

            <!-- Controls Section -->
            <Border Style="{StaticResource CardPanel}" Margin="0 14 0 14" Padding="14" BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1">
                <StackPanel>
                    <!-- Top Row with Date, Search, and Buttons -->
                    <StackPanel Orientation="Horizontal" Margin="0 0 0 12">
                        <!-- Date Picker -->
                        <StackPanel Orientation="Vertical" Margin="0 0 12 0">
                            <TextBlock Text="Date" Foreground="{StaticResource TextSecondary}" FontSize="11" Margin="0 0 0 4"/>
                            <DatePicker SelectedDate="{Binding SelectedDate}" Width="150" Height="32" VerticalAlignment="Center" 
                                        Style="{StaticResource DarkDatePicker}" BorderThickness="0" BorderBrush="{StaticResource BackgroundSecondary}"/>
                        </StackPanel>

                        <!-- Search Box -->
                        <StackPanel Orientation="Vertical" Margin="0 0 12 0">
                            <TextBlock Text="Search" Foreground="{StaticResource TextSecondary}" FontSize="11" Margin="0 0 0 4"/>
                            <TextBox Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}" Height="38" Width="200" 
                                     Background="{StaticResource BackgroundSecondary}" Foreground="{StaticResource TextPrimary}" 
                                     BorderBrush="{StaticResource BackgroundCard}" BorderThickness="1" Padding="8,6"/>
                        </StackPanel>

                        <!-- Buttons -->
                        <StackPanel Orientation="Vertical">
                            <TextBlock Text="" Foreground="{StaticResource TextSecondary}" FontSize="11" Margin="0 0 0 4" Height="15"/>
                            <StackPanel Orientation="Horizontal">
                                <Button Content="Refresh" Command="{Binding RefreshDataCommand}" Height="32" Style="{StaticResource ActionButton}" Margin="0 0 5 0"/>
                                <Button Content="Cleanup" Command="{Binding CleanupOldDataCommand}" Height="32" Style="{StaticResource ActionButton}"/>
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>

                    <!-- Logs Directory -->
                    <StackPanel Orientation="Vertical">
                        <TextBlock Text="{Binding SessionLogsDirectory, StringFormat=Logs: {0}}"
                                   Foreground="{StaticResource TextSecondary}"
                                   FontSize="11"
                                   TextTrimming="CharacterEllipsis"
                                   Cursor="Hand"
                                   ToolTip="Double click to copy">
                            <TextBlock.InputBindings>
                                <MouseBinding MouseAction="LeftDoubleClick" Command="{Binding CopySessionLogsDirectoryCommand}"/>
                            </TextBlock.InputBindings>
                        </TextBlock>
                        <TextBlock Text="{Binding CopyStatusText}" Foreground="#22C55E" FontSize="11" Margin="0 2 0 0"/>
                    </StackPanel>
                    <!-- Filter Mode Display -->
                    <StackPanel Orientation="Horizontal" Margin="0 8 0 0">
                        <TextBlock Text="Filter: " Foreground="{StaticResource TextSecondary}" FontSize="11"/>
                        <TextBlock Text="{Binding FilterModeText}" Foreground="{DynamicResource AccentBrush}" FontSize="11" FontWeight="SemiBold" Margin="4 0 8 0"/>
                        <TextBlock Text="[Check Out Settings For More]" Foreground="{StaticResource TextSecondary}" FontSize="11" Cursor="Hand" ToolTip="Click to open Settings">
                            <TextBlock.InputBindings>
                                <MouseBinding MouseAction="LeftClick" Command="{Binding OpenSettingsCommand}"/>
                            </TextBlock.InputBindings>
                        </TextBlock>
                        <Control Style="{StaticResource InfoIcon}" Margin="8 0 0 0" VerticalAlignment="Center"
                                 ToolTip="Filter controls which apps are tracked.&#10;All Apps = Track everything&#10;Exclude DevTools = Skip VS Code, etc.&#10;Only DevTools = Track only dev tools"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Overview Cards -->
            <UniformGrid Columns="4" Margin="0 14 0 14">
                <Border Style="{StaticResource CardPanel}" Margin="0 0 10 0" Padding="14" BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="Apps" Foreground="{StaticResource TextSecondary}" FontSize="11"/>
                        <TextBlock Text="{Binding AppSummaries.Count}" Foreground="{StaticResource TextPrimary}" FontSize="20" FontWeight="Bold" Margin="0 6 0 0"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource CardPanel}" Margin="0 0 10 0" Padding="14" BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="Sessions" Foreground="{StaticResource TextSecondary}" FontSize="11"/>
                        <TextBlock Text="{Binding Sessions.Count}" Foreground="{StaticResource TextPrimary}" FontSize="20" FontWeight="Bold" Margin="0 6 0 0"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource CardPanel}" Margin="0 0 10 0" Padding="14" BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="Top App" Foreground="{StaticResource TextSecondary}" FontSize="11"/>
                        <TextBlock Text="{Binding TopAppName}" Foreground="{StaticResource TextPrimary}" FontSize="16" FontWeight="SemiBold" Margin="0 6 0 0" TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="{Binding TopAppSessionsText}" Foreground="{StaticResource TextSecondary}" FontSize="11"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource CardPanel}" Margin="0" Padding="14" BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="Longest Session" Foreground="{StaticResource TextSecondary}" FontSize="11"/>
                        <TextBlock Text="{Binding LongestSessionText}" Foreground="{StaticResource TextPrimary}" FontSize="16" FontWeight="SemiBold" Margin="0 6 0 0"/>
                    </StackPanel>
                </Border>
            </UniformGrid>

            <!-- Export Controls -->
            <Border Style="{StaticResource CardPanel}" Margin="0 0 0 14" Padding="14" BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" Text="Export Data" Foreground="{StaticResource TextPrimary}" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="From:" Foreground="{StaticResource TextSecondary}" FontSize="12" Margin="0 0 6 0" VerticalAlignment="Center"/>
                        <DatePicker SelectedDate="{Binding StartDate}" Width="120" Height="28" VerticalAlignment="Center" Style="{StaticResource DarkDatePicker}" BorderThickness="0" BorderBrush="{StaticResource BackgroundSecondary}"/>
                        <TextBlock Text="To:" Foreground="{StaticResource TextSecondary}" FontSize="12" Margin="12 0 6 0" VerticalAlignment="Center"/>
                        <DatePicker SelectedDate="{Binding EndDate}" Width="120" Height="28" VerticalAlignment="Center" Style="{StaticResource DarkDatePicker}" BorderThickness="0" BorderBrush="{StaticResource BackgroundSecondary}"/>
                    </StackPanel>

                    <Button Grid.Column="3" Content="Export CSV" Command="{Binding ExportToCsvCommand}" Height="28" Style="{StaticResource ActionButton}" Margin="10 0 5 0"/>
                    <Button Grid.Column="4" Content="Export JSON" Command="{Binding ExportToJsonCommand}" Height="28" Style="{StaticResource ActionButton}" Margin="5 0 0 0"/>
                </Grid>
            </Border>

            <StackPanel Orientation="Horizontal" Margin="0 20 0 8">
                <TextBlock Text="App Summary" Foreground="{StaticResource TextPrimary}" FontSize="16" FontWeight="SemiBold"/>
                <Control Style="{StaticResource InfoIcon}" Margin="8 0 0 0" VerticalAlignment="Center"
              ToolTip="Completed unique app sessions from today.&#10;Shows duration, peak/average CPU and memory usage."/>
            </StackPanel>


            <!-- Empty State -->
            <Border Background="{StaticResource BackgroundCard}"
                    BorderBrush="{DynamicResource AccentBrush}"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="40"
                    Margin="0 0 0 14"
                    Visibility="{Binding AppSummaries.Count, Converter={StaticResource BoolToVisibility}, ConverterParameter=Inverted}">
                <StackPanel HorizontalAlignment="Center">
                    <TextBlock Text="??" FontSize="48" HorizontalAlignment="Center" Margin="0 0 0 16"/>
                    <TextBlock Text="No Session Data Yet" 
                               Foreground="{StaticResource TextPrimary}" 
                               FontSize="18" 
                               FontWeight="SemiBold"
                               HorizontalAlignment="Center"
                               Margin="0 0 0 8"/>
                    <TextBlock Text="Start using applications and they will appear here.&#10;Session tracking begins automatically when apps are launched." 
                               Foreground="{StaticResource TextSecondary}" 
                               FontSize="13"
                               HorizontalAlignment="Center"
                               TextAlignment="Center"/>
                </StackPanel>
            </Border>

            <!-- App Summary Header with InfoIcon -->
            <StackPanel Orientation="Horizontal" Margin="0 0 0 8" Visibility="{Binding AppSummaries.Count, Converter={StaticResource BoolToVisibility}}">
                <TextBlock Text="App Summary" Foreground="{StaticResource TextPrimary}" FontSize="16" FontWeight="SemiBold"/>
                <Control Style="{StaticResource InfoIcon}" Margin="8 0 0 0" VerticalAlignment="Center"
                         ToolTip="Overview of all applications used today.&#10;Shows session counts, CPU/memory usage stats.&#10;Right-click column headers to customize view."/>
            </StackPanel>

            <Border Background="{StaticResource BackgroundCard}"
                    BorderThickness="1"
                    CornerRadius="10"
                    SnapsToDevicePixels="True"
                    Padding="0"
                    Margin="0 0 0 14">
                <Border.Clip>
                    <RectangleGeometry RadiusX="10" RadiusY="10" Rect="0,0,10000,10000"/>
                </Border.Clip>

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <DataGrid Grid.Row="0"
                              ItemsSource="{Binding PagedAppSummaries}"
                              Style="{StaticResource DarkDataGrid}"
                              AutoGenerateColumns="False"
                              HeadersVisibility="Column"
                              HorizontalAlignment="Stretch"
                              HorizontalContentAlignment="Stretch"
                              VerticalAlignment="Center"
                              VerticalContentAlignment="Center"
                              x:Name="AppSummaryGrid">
                        <DataGrid.ContextMenu>
                            <ContextMenu Style="{StaticResource DarkContextMenu}">
                                <MenuItem Header="Application" IsCheckable="True" IsChecked="{Binding PlacementTarget.DataContext.ShowSummaryApp, RelativeSource={RelativeSource AncestorType=ContextMenu}}" Style="{StaticResource DarkMenuItem}"/>
                                <MenuItem Header="Sessions" IsCheckable="True" IsChecked="{Binding PlacementTarget.DataContext.ShowSummarySessions, RelativeSource={RelativeSource AncestorType=ContextMenu}}" Style="{StaticResource DarkMenuItem}"/>
                                <MenuItem Header="Longest" IsCheckable="True" IsChecked="{Binding PlacementTarget.DataContext.ShowSummaryLongest, RelativeSource={RelativeSource AncestorType=ContextMenu}}" Style="{StaticResource DarkMenuItem}"/>
                                <MenuItem Header="Peak CPU %" IsCheckable="True" IsChecked="{Binding PlacementTarget.DataContext.ShowSummaryPeakCpu, RelativeSource={RelativeSource AncestorType=ContextMenu}}" Style="{StaticResource DarkMenuItem}"/>
                                <MenuItem Header="Avg CPU %" IsCheckable="True" IsChecked="{Binding PlacementTarget.DataContext.ShowSummaryAvgCpu, RelativeSource={RelativeSource AncestorType=ContextMenu}}" Style="{StaticResource DarkMenuItem}"/>
                                <MenuItem Header="Peak Memory" IsCheckable="True" IsChecked="{Binding PlacementTarget.DataContext.ShowSummaryPeakMem, RelativeSource={RelativeSource AncestorType=ContextMenu}}" Style="{StaticResource DarkMenuItem}"/>
                                <MenuItem Header="Avg Memory" IsCheckable="True" IsChecked="{Binding PlacementTarget.DataContext.ShowSummaryAvgMem, RelativeSource={RelativeSource AncestorType=ContextMenu}}" Style="{StaticResource DarkMenuItem}"/>
                            </ContextMenu>
                        </DataGrid.ContextMenu>
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="Application" Width="Auto" MinWidth="120" Visibility="{Binding Data.ShowSummaryApp, Source={StaticResource VmProxy}, Converter={StaticResource BoolToVisibility}}">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="12,6">
                                            <Image Source="{Binding Icon}" Width="20" Height="20" Stretch="Uniform" Margin="0,0,8,0"/>
                                            <TextBlock Text="{Binding AppName}" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="Sessions" Binding="{Binding SessionCount}" Width="Auto" MinWidth="70" Visibility="{Binding Data.ShowSummarySessions, Source={StaticResource VmProxy}, Converter={StaticResource BoolToVisibility}}">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="HorizontalAlignment" Value="Left"/>
                                        <Setter Property="Padding" Value="12,6"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="Longest" Binding="{Binding LongestSessionDisplay}" Width="Auto" MinWidth="80" Visibility="{Binding Data.ShowSummaryLongest, Source={StaticResource VmProxy}, Converter={StaticResource BoolToVisibility}}">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="HorizontalAlignment" Value="Left"/>
                                        <Setter Property="Padding" Value="12,6"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="Peak CPU %" Binding="{Binding PeakCpuPercent, StringFormat={}{0:F1}}" Width="Auto" MinWidth="85" Visibility="{Binding Data.ShowSummaryPeakCpu, Source={StaticResource VmProxy}, Converter={StaticResource BoolToVisibility}}">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="HorizontalAlignment" Value="Left"/>
                                        <Setter Property="Padding" Value="12,6"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="Avg CPU %" Binding="{Binding AverageCpuPercent, StringFormat={}{0:F1}}" Width="Auto" MinWidth="80" Visibility="{Binding Data.ShowSummaryAvgCpu, Source={StaticResource VmProxy}, Converter={StaticResource BoolToVisibility}}">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="HorizontalAlignment" Value="Left"/>
                                        <Setter Property="Padding" Value="12,6"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="Peak Memory" Binding="{Binding PeakMemoryMb, StringFormat={}{0:F0} MB}" Width="Auto" MinWidth="95" Visibility="{Binding Data.ShowSummaryPeakMem, Source={StaticResource VmProxy}, Converter={StaticResource BoolToVisibility}}">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="HorizontalAlignment" Value="Left"/>
                                        <Setter Property="Padding" Value="12,6"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="Avg Memory" Binding="{Binding AverageMemoryMb, StringFormat={}{0:F0} MB}" Width="Auto" MinWidth="90" Visibility="{Binding Data.ShowSummaryAvgMem, Source={StaticResource VmProxy}, Converter={StaticResource BoolToVisibility}}">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="HorizontalAlignment" Value="Left"/>
                                        <Setter Property="Padding" Value="12,6"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                        </DataGrid.Columns>
                    </DataGrid>

                    <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,10,0,10">
                        <Button Content="Prev" Command="{Binding SummaryPrevPageCommand}" Height="26" Padding="14,0" Margin="0,0,10,0" Style="{StaticResource ActionButton}"/>
                        <TextBlock Text="{Binding SummaryPageText}" Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <Button Content="Next" Command="{Binding SummaryNextPageCommand}" Height="26" Padding="14,0" Style="{StaticResource ActionButton}"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Currently Running Header with InfoIcon -->
            <StackPanel Orientation="Horizontal" Margin="0 20 0 8">
                <TextBlock Text="Currently Running" Foreground="{StaticResource TextPrimary}" FontSize="16" FontWeight="SemiBold"/>
                <Control Style="{StaticResource InfoIcon}" Margin="8 0 0 0" VerticalAlignment="Center"
                         ToolTip="Apps currently active and being tracked.&#10;Shows real-time CPU/memory usage.&#10;When closed, apps move to Old Sessions."/>
            </StackPanel>

            <Border Background="{StaticResource BackgroundCard}"
                    BorderThickness="1"
                    CornerRadius="10"
                    SnapsToDevicePixels="True"
                    Padding="0"
                    Margin="0">
                <Border.Clip>
                    <RectangleGeometry RadiusX="10" RadiusY="10" Rect="0,0,10000,10000"/>
                </Border.Clip>

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <DataGrid Grid.Row="0"
                              ItemsSource="{Binding CurrentlyRunning}"
                              Style="{StaticResource DarkDataGrid}"
                              AutoGenerateColumns="False"
                              HeadersVisibility="Column"
                              HorizontalAlignment="Stretch"
                              HorizontalContentAlignment="Stretch"
                              VerticalAlignment="Center"
                              VerticalContentAlignment="Center"
                              x:Name="CurrentlyRunningGrid">
                        <DataGrid.ContextMenu>
                            <ContextMenu Style="{StaticResource DarkContextMenu}">
                                <MenuItem Header="Application" IsCheckable="True" IsChecked="{Binding PlacementTarget.DataContext.ShowRunningApp, RelativeSource={RelativeSource AncestorType=ContextMenu}}" Style="{StaticResource DarkMenuItem}"/>
                                <MenuItem Header="PID" IsCheckable="True" IsChecked="{Binding PlacementTarget.DataContext.ShowRunningPid, RelativeSource={RelativeSource AncestorType=ContextMenu}}" Style="{StaticResource DarkMenuItem}"/>
                                <MenuItem Header="Started" IsCheckable="True" IsChecked="{Binding PlacementTarget.DataContext.ShowRunningStart, RelativeSource={RelativeSource AncestorType=ContextMenu}}" Style="{StaticResource DarkMenuItem}"/>
                                <MenuItem Header="Duration" IsCheckable="True" IsChecked="{Binding PlacementTarget.DataContext.ShowRunningDuration, RelativeSource={RelativeSource AncestorType=ContextMenu}}" Style="{StaticResource DarkMenuItem}"/>
                                <MenuItem Header="CPU %" IsCheckable="True" IsChecked="{Binding PlacementTarget.DataContext.ShowRunningCpu, RelativeSource={RelativeSource AncestorType=ContextMenu}}" Style="{StaticResource DarkMenuItem}"/>
                                <MenuItem Header="Memory" IsCheckable="True" IsChecked="{Binding PlacementTarget.DataContext.ShowRunningMem, RelativeSource={RelativeSource AncestorType=ContextMenu}}" Style="{StaticResource DarkMenuItem}"/>
                            </ContextMenu>
                        </DataGrid.ContextMenu>
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="Application" Width="Auto" MinWidth="120" Visibility="{Binding Data.ShowRunningApp, Source={StaticResource VmProxy}, Converter={StaticResource BoolToVisibility}}">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="12,6">
                                            <Image Source="{Binding Icon}" Width="20" Height="20" Stretch="Uniform" Margin="0,0,8,0"/>
                                            <TextBlock Text="{Binding AppName}" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="PID" Binding="{Binding ProcessId}" Width="Auto" MinWidth="60" Visibility="{Binding Data.ShowRunningPid, Source={StaticResource VmProxy}, Converter={StaticResource BoolToVisibility}}">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="HorizontalAlignment" Value="Left"/>
                                        <Setter Property="Padding" Value="12,6"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="Started" Binding="{Binding StartTimeLocal, StringFormat={}{0:HH:mm:ss}}" Width="Auto" MinWidth="70" Visibility="{Binding Data.ShowRunningStart, Source={StaticResource VmProxy}, Converter={StaticResource BoolToVisibility}}">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="HorizontalAlignment" Value="Left"/>
                                        <Setter Property="Padding" Value="12,6"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="Duration" Binding="{Binding DurationDisplay}" Width="Auto" MinWidth="70" Visibility="{Binding Data.ShowRunningDuration, Source={StaticResource VmProxy}, Converter={StaticResource BoolToVisibility}}">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="HorizontalAlignment" Value="Left"/>
                                        <Setter Property="Padding" Value="12,6"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="CPU %" Binding="{Binding CurrentCpuPercent, StringFormat={}{0:F1}}" Width="Auto" MinWidth="60" Visibility="{Binding Data.ShowRunningCpu, Source={StaticResource VmProxy}, Converter={StaticResource BoolToVisibility}}">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="HorizontalAlignment" Value="Left"/>
                                        <Setter Property="Padding" Value="12,6"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="Memory" Binding="{Binding CurrentMemoryMb, StringFormat={}{0:F0} MB}" Width="Auto" MinWidth="80" Visibility="{Binding Data.ShowRunningMem, Source={StaticResource VmProxy}, Converter={StaticResource BoolToVisibility}}">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="HorizontalAlignment" Value="Left"/>
                                        <Setter Property="Padding" Value="12,6"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                        </DataGrid.Columns>
                    </DataGrid>

                    <TextBlock Grid.Row="1" Text="Apps appear here while running. When closed, they move to Old Sessions." 
                               Foreground="{StaticResource TextSecondary}" 
                               FontSize="11"
                               HorizontalAlignment="Center"
                               Margin="0,8,0,8"/>
                </Grid>
            </Border>

            <!-- Old Sessions Header with InfoIcon -->
            <StackPanel Orientation="Horizontal" Margin="0 20 0 8">
                <TextBlock Text="Old Sessions" Foreground="{StaticResource TextPrimary}" FontSize="16" FontWeight="SemiBold"/>
                <Control Style="{StaticResource InfoIcon}" Margin="8 0 0 0" VerticalAlignment="Center"
                         ToolTip="Completed app sessions from today.&#10;Shows duration, peak/average CPU and memory usage.&#10;Data is saved locally and can be exported."/>
            </StackPanel>

            <Border Background="{StaticResource BackgroundCard}"
                    BorderThickness="1"
                    CornerRadius="10"
                    SnapsToDevicePixels="True"
                    Padding="0"
                    Margin="0">
                <Border.Clip>
                    <RectangleGeometry RadiusX="10" RadiusY="10" Rect="0,0,10000,10000"/>
                </Border.Clip>

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <DataGrid Grid.Row="0"
                              ItemsSource="{Binding PagedSessions}"
                              Style="{StaticResource DarkDataGrid}"
                              AutoGenerateColumns="False"
                              HeadersVisibility="Column"
                              HorizontalAlignment="Stretch"
                              HorizontalContentAlignment="Stretch"
                              VerticalAlignment="Center"
                              VerticalContentAlignment="Center"
                              x:Name="SessionsGrid">
                        <DataGrid.ContextMenu>
                            <ContextMenu Style="{StaticResource DarkContextMenu}">
                                <MenuItem Header="Application" IsCheckable="True" IsChecked="{Binding PlacementTarget.DataContext.ShowSessionApp, RelativeSource={RelativeSource AncestorType=ContextMenu}}" Style="{StaticResource DarkMenuItem}"/>
                                <MenuItem Header="PID" IsCheckable="True" IsChecked="{Binding PlacementTarget.DataContext.ShowSessionPid, RelativeSource={RelativeSource AncestorType=ContextMenu}}" Style="{StaticResource DarkMenuItem}"/>
                                <MenuItem Header="Start" IsCheckable="True" IsChecked="{Binding PlacementTarget.DataContext.ShowSessionStart, RelativeSource={RelativeSource AncestorType=ContextMenu}}" Style="{StaticResource DarkMenuItem}"/>
                                <MenuItem Header="End" IsCheckable="True" IsChecked="{Binding PlacementTarget.DataContext.ShowSessionEnd, RelativeSource={RelativeSource AncestorType=ContextMenu}}" Style="{StaticResource DarkMenuItem}"/>
                                <MenuItem Header="Duration" IsCheckable="True" IsChecked="{Binding PlacementTarget.DataContext.ShowSessionDuration, RelativeSource={RelativeSource AncestorType=ContextMenu}}" Style="{StaticResource DarkMenuItem}"/>
                                <MenuItem Header="Peak CPU %" IsCheckable="True" IsChecked="{Binding PlacementTarget.DataContext.ShowSessionPeakCpu, RelativeSource={RelativeSource AncestorType=ContextMenu}}" Style="{StaticResource DarkMenuItem}"/>
                                <MenuItem Header="Avg CPU %" IsCheckable="True" IsChecked="{Binding PlacementTarget.DataContext.ShowSessionAvgCpu, RelativeSource={RelativeSource AncestorType=ContextMenu}}" Style="{StaticResource DarkMenuItem}"/>
                                <MenuItem Header="Peak Memory" IsCheckable="True" IsChecked="{Binding PlacementTarget.DataContext.ShowSessionPeakMem, RelativeSource={RelativeSource AncestorType=ContextMenu}}" Style="{StaticResource DarkMenuItem}"/>
                                <MenuItem Header="Avg Memory" IsCheckable="True" IsChecked="{Binding PlacementTarget.DataContext.ShowSessionAvgMem, RelativeSource={RelativeSource AncestorType=ContextMenu}}" Style="{StaticResource DarkMenuItem}"/>
                            </ContextMenu>
                        </DataGrid.ContextMenu>
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="Application" Width="Auto" MinWidth="120" Visibility="{Binding Data.ShowSessionApp, Source={StaticResource VmProxy}, Converter={StaticResource BoolToVisibility}}">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="12,6">
                                            <Image Source="{Binding Icon}" Width="20" Height="20" Stretch="Uniform" Margin="0,0,8,0"/>
                                            <TextBlock Text="{Binding AppName}" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="PID" Binding="{Binding ProcessId}" Width="Auto" MinWidth="60" Visibility="{Binding Data.ShowSessionPid, Source={StaticResource VmProxy}, Converter={StaticResource BoolToVisibility}}">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="HorizontalAlignment" Value="Left"/>
                                        <Setter Property="Padding" Value="12,6"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="Start" Binding="{Binding StartDisplay}" Width="Auto" MinWidth="70" Visibility="{Binding Data.ShowSessionStart, Source={StaticResource VmProxy}, Converter={StaticResource BoolToVisibility}}">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="HorizontalAlignment" Value="Left"/>
                                        <Setter Property="Padding" Value="12,6"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="End" Binding="{Binding EndDisplay}" Width="Auto" MinWidth="70" Visibility="{Binding Data.ShowSessionEnd, Source={StaticResource VmProxy}, Converter={StaticResource BoolToVisibility}}">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="HorizontalAlignment" Value="Left"/>
                                        <Setter Property="Padding" Value="12,6"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="Duration" Binding="{Binding DurationDisplay}" Width="Auto" MinWidth="70" Visibility="{Binding Data.ShowSessionDuration, Source={StaticResource VmProxy}, Converter={StaticResource BoolToVisibility}}">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="HorizontalAlignment" Value="Left"/>
                                        <Setter Property="Padding" Value="12,6"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="Peak CPU %" Binding="{Binding PeakCpuPercent, StringFormat={}{0:F1}}" Width="Auto" MinWidth="85" Visibility="{Binding Data.ShowSessionPeakCpu, Source={StaticResource VmProxy}, Converter={StaticResource BoolToVisibility}}">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="HorizontalAlignment" Value="Left"/>
                                        <Setter Property="Padding" Value="12,6"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="Avg CPU %" Binding="{Binding AverageCpuPercent, StringFormat={}{0:F1}}" Width="Auto" MinWidth="80" Visibility="{Binding Data.ShowSessionAvgCpu, Source={StaticResource VmProxy}, Converter={StaticResource BoolToVisibility}}">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="HorizontalAlignment" Value="Left"/>
                                        <Setter Property="Padding" Value="12,6"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="Peak Memory" Binding="{Binding PeakMemoryMb, StringFormat={}{0:F0} MB}" Width="Auto" MinWidth="95" Visibility="{Binding Data.ShowSessionPeakMem, Source={StaticResource VmProxy}, Converter={StaticResource BoolToVisibility}}">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="HorizontalAlignment" Value="Left"/>
                                        <Setter Property="Padding" Value="12,6"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="Avg Memory" Binding="{Binding AverageMemoryMb, StringFormat={}{0:F0} MB}" Width="Auto" MinWidth="90" Visibility="{Binding Data.ShowSessionAvgMem, Source={StaticResource VmProxy}, Converter={StaticResource BoolToVisibility}}">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="HorizontalAlignment" Value="Left"/>
                                        <Setter Property="Padding" Value="12,6"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                        </DataGrid.Columns>
                    </DataGrid>

                    <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,10,0,10">
                        <Button Content="Prev" Command="{Binding SessionsPrevPageCommand}" Height="26" Padding="14,0" Margin="0,0,10,0" Style="{StaticResource ActionButton}"/>
                        <TextBlock Text="{Binding SessionsPageText}" Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <Button Content="Next" Command="{Binding SessionsNextPageCommand}" Height="26" Padding="14,0" Style="{StaticResource ActionButton}"/>
                    </StackPanel>
                </Grid>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
