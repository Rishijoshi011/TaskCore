<UserControl x:Class="TaskCore.Views.GraphsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF"
             xmlns:vm="clr-namespace:TaskCore.ViewModels"
             Background="{StaticResource BackgroundPrimary}"
             Padding="20">

    <UserControl.DataContext>
        <vm:GraphsViewModel />
    </UserControl.DataContext>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Text="System Usage"
                   FontSize="26"
                   FontWeight="Bold"
                   Foreground="{StaticResource AccentBrush}"
                   Margin="0 0 0 20"/>

        <Border Grid.Row="1"
                Style="{StaticResource CardPanel}"
                Padding="20">

            <StackPanel>

                <!-- CPU -->
                <TextBlock Text="CPU Usage (%)"
                           FontSize="16"
                           Margin="0 0 0 5"/>

                <lvc:CartesianChart Series="{Binding CpuSeries}"
                                    Height="200" />

                <!-- RAM -->
                <TextBlock Text="RAM Usage (MB)"
                           FontSize="16"
                           Margin="0 20 0 5"/>

                <lvc:CartesianChart Series="{Binding RamSeries}"
                                    Height="200" />

            </StackPanel>

        </Border>

    </Grid>

</UserControl>
