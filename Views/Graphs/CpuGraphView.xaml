<UserControl x:Class="TaskCore.Views.Graphs.CpuGraphView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF"
             xmlns:vm="clr-namespace:TaskCore.ViewModels.Graphs"
             Background="{StaticResource BackgroundPrimary}"
             Padding="30">

    <UserControl.DataContext>
        <vm:CpuGraphViewModel />
    </UserControl.DataContext>

    <UserControl.Resources>
        <!-- Dark mode theme for LiveCharts -->
        <lvc:SolidColorPaint x:Key="DarkBackground" Color="#1E1E1E"/>
        <lvc:SolidColorPaint x:Key="DarkGrid" Color="#333333"/>
        <lvc:SolidColorPaint x:Key="DarkText" Color="#CCCCCC"/>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid MinWidth="300">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Title -->
            <TextBlock Text="CPU Usage (%)"
                       FontSize="22"
                       FontWeight="Bold"
                       Margin="0 0 0 20"
                       Foreground="#8A2BE2"
                       Grid.Row="0"/>

            <!-- Graph Container -->
            <Border Background="#1E1E1E" CornerRadius="6" Padding="15" Grid.Row="1" Margin="0 0 0 25">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    
                    <!-- CPU Name and Current Utilization -->
                    <Grid Grid.Row="0" Margin="0 0 0 15">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding CpuName}"
                                   FontSize="14"
                                   FontWeight="SemiBold"
                                   Foreground="#CCCCCC"
                                   Grid.Column="0"
                                   TextTrimming="CharacterEllipsis"
                                   TextWrapping="Wrap"/>
                        <TextBlock Text="{Binding CurrentUtilization, StringFormat='{}{0:F1}%'}"
                                   FontSize="16"
                                   FontWeight="Bold"
                                   Foreground="#8A2BE2"
                                   Grid.Column="1"
                                   Margin="10,0,0,0"/>
                    </Grid>

                    <!-- Chart -->
                    <lvc:CartesianChart Series="{Binding Series}"
                                        Height="200"
                                        MinHeight="150"
                                        Background="Transparent"
                                        AnimationsSpeed="00:00:00.500"
                                        Grid.Row="1"/>
                </Grid>
            </Border>

            <!-- CPU Information Panel -->
            <Border Background="#1E1E1E" CornerRadius="4" Padding="15" Margin="0 10 0 0" Grid.Row="2">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <Grid MinWidth="250">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Row 1 - Basic Info -->
                        <TextBlock Text="Utilization:" Foreground="#999999" FontSize="11" Grid.Column="0" Grid.Row="0" VerticalAlignment="Top"/>
                        <TextBlock Text="{Binding CurrentUtilization, StringFormat='{}{0:F1}%'}" Foreground="#8A2BE2" FontSize="11" Grid.Column="0" Grid.Row="1" Margin="0 0 0 8" VerticalAlignment="Top"/>

                        <TextBlock Text="Speed:" Foreground="#999999" FontSize="11" Grid.Column="1" Grid.Row="0" VerticalAlignment="Top"/>
                        <TextBlock Text="{Binding CurrentSpeed, StringFormat='{}{0:F2} GHz'}" Foreground="#CCCCCC" FontSize="11" Grid.Column="1" Grid.Row="1" Margin="0 0 0 8" VerticalAlignment="Top"/>

                        <TextBlock Text="Processes:" Foreground="#999999" FontSize="11" Grid.Column="2" Grid.Row="0" VerticalAlignment="Top"/>
                        <TextBlock Text="{Binding Processes}" Foreground="#CCCCCC" FontSize="11" Grid.Column="2" Grid.Row="1" Margin="0 0 0 8" VerticalAlignment="Top"/>

                        <TextBlock Text="Threads:" Foreground="#999999" FontSize="11" Grid.Column="3" Grid.Row="0" VerticalAlignment="Top"/>
                        <TextBlock Text="{Binding Threads}" Foreground="#CCCCCC" FontSize="11" Grid.Column="3" Grid.Row="1" Margin="0 0 0 8" VerticalAlignment="Top"/>

                        <!-- Row 2 - System Info -->
                        <TextBlock Text="Handles:" Foreground="#999999" FontSize="11" Grid.Column="0" Grid.Row="2" VerticalAlignment="Top"/>
                        <TextBlock Text="{Binding Handles}" Foreground="#CCCCCC" FontSize="11" Grid.Column="0" Grid.Row="3" Margin="0 0 0 8" VerticalAlignment="Top"/>

                        <TextBlock Text="Up time:" Foreground="#999999" FontSize="11" Grid.Column="1" Grid.Row="2" VerticalAlignment="Top"/>
                        <TextBlock Text="{Binding UpTime}" Foreground="#CCCCCC" FontSize="11" Grid.Column="1" Grid.Row="3" Margin="0 0 0 8" VerticalAlignment="Top"/>

                        <TextBlock Text="Base speed:" Foreground="#999999" FontSize="11" Grid.Column="2" Grid.Row="2" VerticalAlignment="Top"/>
                        <TextBlock Text="{Binding BaseSpeed, StringFormat='{}{0:F2} GHz'}" Foreground="#CCCCCC" FontSize="11" Grid.Column="2" Grid.Row="3" Margin="0 0 0 8" VerticalAlignment="Top"/>

                        <TextBlock Text="Sockets:" Foreground="#999999" FontSize="11" Grid.Column="3" Grid.Row="2" VerticalAlignment="Top"/>
                        <TextBlock Text="{Binding Sockets}" Foreground="#CCCCCC" FontSize="11" Grid.Column="3" Grid.Row="3" Margin="0 0 0 8" VerticalAlignment="Top"/>

                        <!-- Row 3 - Core Info -->
                        <TextBlock Text="Cores:" Foreground="#999999" FontSize="11" Grid.Column="0" Grid.Row="4" VerticalAlignment="Top"/>
                        <TextBlock Text="{Binding Cores}" Foreground="#CCCCCC" FontSize="11" Grid.Column="0" Grid.Row="5" Margin="0 0 0 8" VerticalAlignment="Top"/>

                        <TextBlock Text="Logical processors:" Foreground="#999999" FontSize="11" Grid.Column="1" Grid.Row="4" VerticalAlignment="Top"/>
                        <TextBlock Text="{Binding LogicalProcessors}" Foreground="#CCCCCC" FontSize="11" Grid.Column="1" Grid.Row="5" Margin="0 0 0 8" VerticalAlignment="Top"/>

                        <TextBlock Text="Virtualization:" Foreground="#999999" FontSize="11" Grid.Column="2" Grid.Row="4" VerticalAlignment="Top"/>
                        <TextBlock Text="{Binding Virtualization}" Foreground="#CCCCCC" FontSize="11" Grid.Column="2" Grid.Row="5" Margin="0 0 0 8" VerticalAlignment="Top"/>

                        <TextBlock Text="Architecture:" Foreground="#999999" FontSize="11" Grid.Column="3" Grid.Row="4" VerticalAlignment="Top"/>
                        <TextBlock Text="{Binding Architecture}" Foreground="#CCCCCC" FontSize="11" Grid.Column="3" Grid.Row="5" Margin="0 0 0 8" VerticalAlignment="Top"/>

                        <!-- Row 4 - Cache Info -->
                        <TextBlock Text="L1 Cache:" Foreground="#999999" FontSize="11" Grid.Column="0" Grid.Row="6" VerticalAlignment="Top"/>
                        <TextBlock Text="{Binding L1Cache}" Foreground="#CCCCCC" FontSize="11" Grid.Column="0" Grid.Row="7" Margin="0 0 0 8" VerticalAlignment="Top"/>

                        <TextBlock Text="L2 Cache:" Foreground="#999999" FontSize="11" Grid.Column="1" Grid.Row="6" VerticalAlignment="Top"/>
                        <TextBlock Text="{Binding L2Cache}" Foreground="#CCCCCC" FontSize="11" Grid.Column="1" Grid.Row="7" Margin="0 0 0 8" VerticalAlignment="Top"/>

                        <TextBlock Text="L3 Cache:" Foreground="#999999" FontSize="11" Grid.Column="2" Grid.Row="6" VerticalAlignment="Top"/>
                        <TextBlock Text="{Binding L3Cache}" Foreground="#CCCCCC" FontSize="11" Grid.Column="2" Grid.Row="7" Margin="0 0 0 8" VerticalAlignment="Top"/>

                        <TextBlock Text="Max Speed:" Foreground="#999999" FontSize="11" Grid.Column="3" Grid.Row="6" VerticalAlignment="Top"/>
                        <TextBlock Text="{Binding MaxClockSpeed}" Foreground="#CCCCCC" FontSize="11" Grid.Column="3" Grid.Row="7" Margin="0 0 0 8" VerticalAlignment="Top"/>

                        <!-- Row 5 - Manufacturer Info -->
                        <TextBlock Text="Manufacturer:" Foreground="#999999" FontSize="11" Grid.Column="0" Grid.Row="8" VerticalAlignment="Top"/>
                        <TextBlock Text="{Binding Manufacturer}" Foreground="#CCCCCC" FontSize="11" Grid.Column="0" Grid.Row="9" Margin="0 0 0 8" VerticalAlignment="Top"/>

                        <TextBlock Text="Family:" Foreground="#999999" FontSize="11" Grid.Column="1" Grid.Row="8" VerticalAlignment="Top"/>
                        <TextBlock Text="{Binding Family}" Foreground="#CCCCCC" FontSize="11" Grid.Column="1" Grid.Row="9" Margin="0 0 0 8" VerticalAlignment="Top"/>

                        <TextBlock Text="Model:" Foreground="#999999" FontSize="11" Grid.Column="2" Grid.Row="8" VerticalAlignment="Top"/>
                        <TextBlock Text="{Binding Model}" Foreground="#CCCCCC" FontSize="11" Grid.Column="2" Grid.Row="9" Margin="0 0 0 8" VerticalAlignment="Top"/>

                        <TextBlock Text="Stepping:" Foreground="#999999" FontSize="11" Grid.Column="3" Grid.Row="8" VerticalAlignment="Top"/>
                        <TextBlock Text="{Binding Stepping}" Foreground="#CCCCCC" FontSize="11" Grid.Column="3" Grid.Row="9" Margin="0 0 0 8" VerticalAlignment="Top"/>

                        <!-- Row 6 - Advanced Info -->
                        <TextBlock Text="Level:" Foreground="#999999" FontSize="11" Grid.Column="0" Grid.Row="10" VerticalAlignment="Top"/>
                        <TextBlock Text="{Binding Level}" Foreground="#CCCCCC" FontSize="11" Grid.Column="0" Grid.Row="11" Margin="0 0 0 8" VerticalAlignment="Top"/>

                        <TextBlock Text="Revision:" Foreground="#999999" FontSize="11" Grid.Column="1" Grid.Row="10" VerticalAlignment="Top"/>
                        <TextBlock Text="{Binding Revision}" Foreground="#CCCCCC" FontSize="11" Grid.Column="1" Grid.Row="11" Margin="0 0 0 8" VerticalAlignment="Top"/>

                        <TextBlock Text="Socket:" Foreground="#999999" FontSize="11" Grid.Column="2" Grid.Row="10" VerticalAlignment="Top"/>
                        <TextBlock Text="{Binding SocketDesignation}" Foreground="#CCCCCC" FontSize="11" Grid.Column="2" Grid.Row="11" Margin="0 0 0 8" VerticalAlignment="Top"/>

                        <TextBlock Text="Type:" Foreground="#999999" FontSize="11" Grid.Column="3" Grid.Row="10" VerticalAlignment="Top"/>
                        <TextBlock Text="{Binding ProcessorType}" Foreground="#CCCCCC" FontSize="11" Grid.Column="3" Grid.Row="11" Margin="0 0 0 8" VerticalAlignment="Top"/>

                        <!-- Row 7 - CPU Name (spans all columns) -->
                        <TextBlock Text="CPU Name:" Foreground="#999999" FontSize="11" Grid.Column="0" Grid.Row="12" VerticalAlignment="Top"/>
                        <TextBlock Text="{Binding CpuName}" Foreground="#8A2BE2" FontSize="11" Grid.Column="0" Grid.ColumnSpan="4" Grid.Row="13" Margin="0 0 0 8" VerticalAlignment="Top" TextWrapping="Wrap" TextTrimming="CharacterEllipsis"/>
                    </Grid>
                </ScrollViewer>
            </Border>
        </Grid>
    </ScrollViewer>

</UserControl>
