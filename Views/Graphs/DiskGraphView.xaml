<UserControl x:Class="TaskCore.Views.Graphs.DiskGraphView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:TaskCore.ViewModels.Graphs"
             xmlns:graphs="clr-namespace:TaskCore.Views.Graphs"
             Background="{StaticResource BackgroundPrimary}"
             Padding="20">

    <UserControl.DataContext>
        <vm:DiskGraphViewModel/>
    </UserControl.DataContext>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel>
            <TextBlock Text="Disk"
                       FontSize="20"
                       FontWeight="Bold"
                       Margin="0 0 0 10"
                       Foreground="#00FFFF"/>

            <ItemsControl ItemsSource="{Binding Disks}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <graphs:DiskCardView/>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
</UserControl>
