<UserControl x:Class="TaskCore.Views.Graphs.GpuCardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF">

    <StackPanel Margin="0 0 0 18">
        <Border Background="#1E1E1E" CornerRadius="4" Padding="10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="0 0 0 15">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Text="{Binding GpuName}"
                               FontSize="14"
                               FontWeight="SemiBold"
                               Foreground="#CCCCCC"
                               Grid.Column="0"
                               TextTrimming="CharacterEllipsis"
                               TextWrapping="Wrap"/>

                    <TextBlock Text="{Binding CurrentUtilization, StringFormat='{}{0:F1}%'}"
                               FontSize="16"
                               FontWeight="Bold"
                               Foreground="#FFDC00"
                               Grid.Column="1"
                               Margin="10,0,0,0"/>
                </Grid>

                <lvc:CartesianChart Series="{Binding Series}"
                                    Height="200"
                                    MinHeight="150"
                                    Background="Transparent"
                                    AnimationsSpeed="00:00:00.500"
                                    Grid.Row="1"/>
            </Grid>
        </Border>

        <Border Background="#1E1E1E" CornerRadius="4" Padding="15" Margin="0 10 0 0">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <Grid MinWidth="250">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Text="Utilization:" Foreground="#999999" FontSize="11" Grid.Column="0" Grid.Row="0"/>
                    <TextBlock Text="{Binding CurrentUtilization, StringFormat='{}{0:F1}%'}" Foreground="#FFDC00" FontSize="11" Grid.Column="0" Grid.Row="1" Margin="0 0 0 8"/>

                    <TextBlock Text="Temperature:" Foreground="#999999" FontSize="11" Grid.Column="1" Grid.Row="0"/>
                    <TextBlock Text="{Binding CurrentTemperatureText}" Foreground="#CCCCCC" FontSize="11" Grid.Column="1" Grid.Row="1" Margin="0 0 0 8"/>

                    <TextBlock Text="VRAM Used:" Foreground="#999999" FontSize="11" Grid.Column="2" Grid.Row="0"/>
                    <TextBlock Text="{Binding CurrentMemoryUsageText}" Foreground="#CCCCCC" FontSize="11" Grid.Column="2" Grid.Row="1" Margin="0 0 0 8"/>

                    <TextBlock Text="VRAM Total:" Foreground="#999999" FontSize="11" Grid.Column="3" Grid.Row="0"/>
                    <TextBlock Text="{Binding TotalMemoryText}" Foreground="#CCCCCC" FontSize="11" Grid.Column="3" Grid.Row="1" Margin="0 0 0 8"/>

                    <TextBlock Text="Manufacturer:" Foreground="#999999" FontSize="11" Grid.Column="0" Grid.Row="2"/>
                    <TextBlock Text="{Binding Manufacturer}" Foreground="#CCCCCC" FontSize="11" Grid.Column="0" Grid.Row="3" Margin="0 0 0 8"/>

                    <TextBlock Text="Driver:" Foreground="#999999" FontSize="11" Grid.Column="2" Grid.Row="2"/>
                    <TextBlock Text="{Binding DriverVersion}" Foreground="#CCCCCC" FontSize="11" Grid.Column="2" Grid.Row="3" Margin="0 0 0 8"/>

                    <TextBlock Text="Driver Date:" Foreground="#999999" FontSize="11" Grid.Column="3" Grid.Row="2"/>
                    <TextBlock Text="{Binding DriverDate}" Foreground="#CCCCCC" FontSize="11" Grid.Column="3" Grid.Row="3" Margin="0 0 0 8"/>

                    <TextBlock Text="Resolution:" Foreground="#999999" FontSize="11" Grid.Column="0" Grid.Row="4"/>
                    <TextBlock Text="{Binding CurrentResolution}" Foreground="#CCCCCC" FontSize="11" Grid.Column="0" Grid.Row="5" Margin="0 0 0 8"/>

                    <TextBlock Text="Refresh:" Foreground="#999999" FontSize="11" Grid.Column="1" Grid.Row="4"/>
                    <TextBlock Text="{Binding CurrentRefreshRate}" Foreground="#CCCCCC" FontSize="11" Grid.Column="1" Grid.Row="5" Margin="0 0 0 8"/>

                    <TextBlock Text="Adapter:" Foreground="#999999" FontSize="11" Grid.Column="2" Grid.Row="4"/>
                    <TextBlock Text="{Binding AdapterCompatibility}" Foreground="#CCCCCC" FontSize="11" Grid.Column="2" Grid.Row="5" Margin="0 0 0 8"/>

                    <TextBlock Text="Status:" Foreground="#999999" FontSize="11" Grid.Column="3" Grid.Row="4"/>
                    <TextBlock Text="{Binding Status}" Foreground="#CCCCCC" FontSize="11" Grid.Column="3" Grid.Row="5" Margin="0 0 0 8"/>

                    <TextBlock Text="Video Proc:" Foreground="#999999" FontSize="11" Grid.Column="0" Grid.Row="6"/>
                    <TextBlock Text="{Binding VideoProcessor}" Foreground="#CCCCCC" FontSize="11" Grid.Column="0" Grid.Row="7" Grid.ColumnSpan="2" Margin="0 0 0 8"/>

                    <TextBlock Text="DAC:" Foreground="#999999" FontSize="11" Grid.Column="2" Grid.Row="6"/>
                    <TextBlock Text="{Binding AdapterDacType}" Foreground="#CCCCCC" FontSize="11" Grid.Column="2" Grid.Row="7" Grid.ColumnSpan="2" Margin="0 0 0 8"/>

                    <TextBlock Text="Video Mode:" Foreground="#999999" FontSize="11" Grid.Column="0" Grid.Row="8"/>
                    <TextBlock Text="{Binding VideoModeDescription}" Foreground="#CCCCCC" FontSize="11" Grid.Column="0" Grid.Row="9" Grid.ColumnSpan="4" Margin="0 0 0 8" TextTrimming="CharacterEllipsis"/>

                    <TextBlock Text="PNP ID:" Foreground="#999999" FontSize="11" Grid.Column="0" Grid.Row="10"/>
                    <TextBlock Text="{Binding PnpDeviceId}" Foreground="#CCCCCC" FontSize="11" Grid.Column="0" Grid.Row="11" Grid.ColumnSpan="4" Margin="0 0 0 8" TextTrimming="CharacterEllipsis"/>

                    <TextBlock Text="INF:" Foreground="#999999" FontSize="11" Grid.Column="0" Grid.Row="12"/>
                    <TextBlock Text="{Binding InfFilename}" Foreground="#CCCCCC" FontSize="11" Grid.Column="0" Grid.Row="13" Grid.ColumnSpan="2" Margin="0 0 0 8" TextTrimming="CharacterEllipsis"/>

                    <TextBlock Text="INF Section:" Foreground="#999999" FontSize="11" Grid.Column="2" Grid.Row="12"/>
                    <TextBlock Text="{Binding InfSection}" Foreground="#CCCCCC" FontSize="11" Grid.Column="2" Grid.Row="13" Grid.ColumnSpan="2" Margin="0 0 0 8" TextTrimming="CharacterEllipsis"/>
                </Grid>
            </ScrollViewer>
        </Border>
    </StackPanel>
</UserControl>
