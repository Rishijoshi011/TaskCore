<UserControl x:Class="TaskCore.Views.Graphs.DiskCardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF">

    <StackPanel Margin="0 0 0 18">
        <Border Background="#1E1E1E" CornerRadius="4" Padding="10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="0 0 0 10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Text="{Binding DiskName}"
                               FontSize="14"
                               FontWeight="SemiBold"
                               Foreground="#CCCCCC"
                               Grid.Column="0"
                               TextTrimming="CharacterEllipsis"
                               TextWrapping="Wrap"/>

                    <TextBlock Text="{Binding CurrentActiveTimeText}"
                               FontSize="16"
                               FontWeight="Bold"
                               Foreground="#00FFFF"
                               Grid.Column="1"
                               Margin="10,0,0,0"/>
                </Grid>

                <lvc:CartesianChart Series="{Binding ReadSeries}"
                                    Height="120"
                                    Background="Transparent"
                                    AnimationsSpeed="00:00:00.500"
                                    Grid.Row="1"/>

                <lvc:CartesianChart Series="{Binding WriteSeries}"
                                    Height="120"
                                    Background="Transparent"
                                    AnimationsSpeed="00:00:00.500"
                                    Grid.Row="2"
                                    Margin="0 10 0 0"/>

                <Grid Grid.Row="3" Margin="0 10 0 0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Text="Read:" Foreground="#999999" FontSize="11" Grid.Column="0" Grid.Row="0"/>
                    <TextBlock Text="{Binding CurrentReadSpeedText}" Foreground="#CCCCCC" FontSize="11" Grid.Column="0" Grid.Row="1" Margin="0 0 0 8"/>

                    <TextBlock Text="Write:" Foreground="#999999" FontSize="11" Grid.Column="1" Grid.Row="0"/>
                    <TextBlock Text="{Binding CurrentWriteSpeedText}" Foreground="#CCCCCC" FontSize="11" Grid.Column="1" Grid.Row="1" Margin="0 0 0 8"/>

                    <TextBlock Text="Queue:" Foreground="#999999" FontSize="11" Grid.Column="2" Grid.Row="0"/>
                    <TextBlock Text="{Binding CurrentQueueLengthText}" Foreground="#CCCCCC" FontSize="11" Grid.Column="2" Grid.Row="1" Margin="0 0 0 8"/>

                    <TextBlock Text="Temp:" Foreground="#999999" FontSize="11" Grid.Column="3" Grid.Row="0"/>
                    <TextBlock Text="{Binding CurrentTemperatureText}" Foreground="#CCCCCC" FontSize="11" Grid.Column="3" Grid.Row="1" Margin="0 0 0 8"/>

                    <TextBlock Text="Size:" Foreground="#999999" FontSize="11" Grid.Column="0" Grid.Row="2"/>
                    <TextBlock Text="{Binding SizeText}" Foreground="#CCCCCC" FontSize="11" Grid.Column="0" Grid.Row="3" Margin="0 0 0 8"/>

                    <TextBlock Text="Media:" Foreground="#999999" FontSize="11" Grid.Column="1" Grid.Row="2"/>
                    <TextBlock Text="{Binding MediaType}" Foreground="#CCCCCC" FontSize="11" Grid.Column="1" Grid.Row="3" Margin="0 0 0 8"/>

                    <TextBlock Text="Interface:" Foreground="#999999" FontSize="11" Grid.Column="2" Grid.Row="2"/>
                    <TextBlock Text="{Binding InterfaceType}" Foreground="#CCCCCC" FontSize="11" Grid.Column="2" Grid.Row="3" Margin="0 0 0 8"/>

                    <TextBlock Text="Status:" Foreground="#999999" FontSize="11" Grid.Column="3" Grid.Row="2"/>
                    <TextBlock Text="{Binding Status}" Foreground="#CCCCCC" FontSize="11" Grid.Column="3" Grid.Row="3" Margin="0 0 0 8"/>

                    <TextBlock Text="Serial:" Foreground="#999999" FontSize="11" Grid.Column="0" Grid.Row="4"/>
                    <TextBlock Text="{Binding SerialNumber}" Foreground="#CCCCCC" FontSize="11" Grid.Column="0" Grid.Row="5" Grid.ColumnSpan="2" Margin="0 0 0 8" TextTrimming="CharacterEllipsis"/>

                    <TextBlock Text="Partitions:" Foreground="#999999" FontSize="11" Grid.Column="2" Grid.Row="4"/>
                    <TextBlock Text="{Binding PartitionsText}" Foreground="#CCCCCC" FontSize="11" Grid.Column="2" Grid.Row="5" Grid.ColumnSpan="2" Margin="0 0 0 8"/>

                    <TextBlock Text="Bus:" Foreground="#999999" FontSize="11" Grid.Column="0" Grid.Row="6"/>
                    <TextBlock Text="{Binding BusType}" Foreground="#CCCCCC" FontSize="11" Grid.Column="0" Grid.Row="7" Margin="0 0 0 8"/>

                    <TextBlock Text="Health:" Foreground="#999999" FontSize="11" Grid.Column="1" Grid.Row="6"/>
                    <TextBlock Text="{Binding HealthStatus}" Foreground="#CCCCCC" FontSize="11" Grid.Column="1" Grid.Row="7" Margin="0 0 0 8"/>

                    <TextBlock Text="Operational:" Foreground="#999999" FontSize="11" Grid.Column="2" Grid.Row="6"/>
                    <TextBlock Text="{Binding OperationalStatus}" Foreground="#CCCCCC" FontSize="11" Grid.Column="2" Grid.Row="7" Grid.ColumnSpan="2" Margin="0 0 0 8" TextTrimming="CharacterEllipsis"/>
                </Grid>
            </Grid>
        </Border>
    </StackPanel>
</UserControl>
