<UserControl x:Class="TaskCore.Views.Graphs.SystemSensorsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:TaskCore.ViewModels.Graphs"
             Background="{StaticResource BackgroundPrimary}"
             Padding="20">

    <UserControl.DataContext>
        <vm:SystemSensorsViewModel/>
    </UserControl.DataContext>

    <UserControl.Resources>
        <!-- Category Filter Chip Style -->
        <Style x:Key="CategoryChipStyle" TargetType="RadioButton">
            <Setter Property="Foreground" Value="#CCCCCC"/>
            <Setter Property="Background" Value="#252526"/>
            <Setter Property="BorderBrush" Value="#3E3E42"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="14,6"/>
            <Setter Property="Margin" Value="0,0,6,6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="14"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
                                <Setter Property="Foreground" Value="White"/>
                                <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Inspector Toggle Button Style -->
        <Style x:Key="InspectorToggleStyle" TargetType="ToggleButton">
            <Setter Property="Foreground" Value="#CCCCCC"/>
            <Setter Property="Background" Value="#252526"/>
            <Setter Property="BorderBrush" Value="#3E3E42"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="14,6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock x:Name="icon" Text="📊" Margin="0,0,8,0" FontSize="12"/>
                                <TextBlock x:Name="txt" Text="Cards View" FontWeight="SemiBold" FontSize="12" Foreground="{TemplateBinding Foreground}"/>
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{DynamicResource AccentBrush}"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                <Setter TargetName="icon" Property="Text" Value="🔍"/>
                                <Setter TargetName="txt" Property="Text" Value="Raw Inspector Table (ON)"/>
                                <Setter TargetName="txt" Property="Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header & Action Bar -->
        <Grid Grid.Row="0" Margin="0,0,0,15">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Orientation="Vertical">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="System Sensors" FontSize="22" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}"/>
                    <Border Background="#2D2D30" CornerRadius="10" Padding="8,2" Margin="12,0,0,0" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding ActiveSensorCount}" Foreground="#00FF88" FontWeight="Bold" FontSize="11"/>
                            <TextBlock Text=" / " Foreground="#888888" FontSize="11"/>
                            <TextBlock Text="{Binding TotalSensorCount}" Foreground="#CCCCCC" FontSize="11"/>
                            <TextBlock Text=" Active Sensors" Foreground="#888888" FontSize="11" Margin="4,0,0,0"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
                <TextBlock Text="Real-time physical hardware monitoring from LibreHardwareMonitor, WMI &amp; Windows APIs"
                           Foreground="#888888" FontSize="12" Margin="0,4,0,0"/>
            </StackPanel>

            <!-- Action Buttons -->
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <!-- Search Box -->
                <Border Background="#1E1E1E" BorderBrush="#333333" BorderThickness="1" CornerRadius="4" Padding="8,4" Margin="0,0,10,0" Width="180">
                    <Grid>
                        <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                 Background="Transparent"
                                 Foreground="#CCCCCC"
                                 BorderThickness="0"
                                 FontSize="12"
                                 VerticalAlignment="Center"/>
                        <TextBlock Text="Search sensors..."
                                   Foreground="#666666"
                                   FontSize="12"
                                   IsHitTestVisible="False"
                                   VerticalAlignment="Center">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SearchText}" Value="">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding SearchText}" Value="{x:Null}">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>
                </Border>

                <!-- Reset Min/Max Button -->
                <Button Command="{Binding ResetMinMaxCommand}"
                        Content="🔄 Reset Min/Max"
                        Background="#252526"
                        Foreground="#CCCCCC"
                        BorderBrush="#3E3E42"
                        BorderThickness="1"
                        Padding="12,6"
                        Margin="0,0,10,0"
                        Height="34"
                        Cursor="Hand">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="4"/>
                        </Style>
                    </Button.Resources>
                </Button>

                <!-- Raw Inspector Toggle Button -->
                <ToggleButton IsChecked="{Binding IsAdvancedMode, Mode=TwoWay}"
                              Style="{StaticResource InspectorToggleStyle}"
                              Height="34"/>
            </StackPanel>
        </Grid>

        <!-- Admin Mode Info Banner (when running without Admin rights) -->
        <Border Grid.Row="1" Background="#1A1A1D" BorderBrush="#333338" BorderThickness="1" CornerRadius="6" Padding="12,8" Margin="0,0,0,12">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsAdminMode}" Value="False">
                            <Setter Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="⚡" FontSize="14" Margin="0,0,8,0"/>
                    <TextBlock Text="User Mode: CPU per-core temperatures active via ACPI/WMI thermal telemetry. " Foreground="#CCCCCC" FontSize="12" VerticalAlignment="Center"/>
                    <TextBlock Text="Run as Admin to unlock native Ring-0 MSR CPU Core Temp &amp; Voltage sensors." Foreground="#888888" FontSize="12" VerticalAlignment="Center"/>
                </StackPanel>
                <Button Grid.Column="1" Command="{Binding RestartAsAdminCommand}" Content="🛡️ Restart as Administrator" Background="{DynamicResource AccentBrush}" Foreground="White" BorderThickness="0" Padding="12,5" Cursor="Hand">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="4"/>
                        </Style>
                    </Button.Resources>
                </Button>
            </Grid>
        </Border>

        <!-- Filter Chips (Categories) -->
        <WrapPanel Grid.Row="2" Margin="0,0,0,15">
            <RadioButton Content="All" Command="{Binding SelectCategoryCommand}" CommandParameter="All" IsChecked="True" Style="{StaticResource CategoryChipStyle}"/>
            <RadioButton Content="CPU" Command="{Binding SelectCategoryCommand}" CommandParameter="CPU" Style="{StaticResource CategoryChipStyle}"/>
            <RadioButton Content="GPU" Command="{Binding SelectCategoryCommand}" CommandParameter="GPU" Style="{StaticResource CategoryChipStyle}"/>
            <RadioButton Content="Memory" Command="{Binding SelectCategoryCommand}" CommandParameter="Memory" Style="{StaticResource CategoryChipStyle}"/>
            <RadioButton Content="Storage" Command="{Binding SelectCategoryCommand}" CommandParameter="Storage" Style="{StaticResource CategoryChipStyle}"/>
            <RadioButton Content="Motherboard" Command="{Binding SelectCategoryCommand}" CommandParameter="Motherboard" Style="{StaticResource CategoryChipStyle}"/>
            <RadioButton Content="Cooling" Command="{Binding SelectCategoryCommand}" CommandParameter="Cooling" Style="{StaticResource CategoryChipStyle}"/>
            <RadioButton Content="Power" Command="{Binding SelectCategoryCommand}" CommandParameter="Power" Style="{StaticResource CategoryChipStyle}"/>
            <RadioButton Content="Battery" Command="{Binding SelectCategoryCommand}" CommandParameter="Battery" Style="{StaticResource CategoryChipStyle}"/>
            <RadioButton Content="Network" Command="{Binding SelectCategoryCommand}" CommandParameter="Network" Style="{StaticResource CategoryChipStyle}"/>
        </WrapPanel>

        <!-- Main Dashboard View: Cards vs Advanced DataGrid -->
        <Grid Grid.Row="3">
            <!-- CARDS DASHBOARD VIEW -->
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <ScrollViewer.Style>
                    <Style TargetType="ScrollViewer">
                        <Setter Property="Visibility" Value="Visible"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsAdvancedMode}" Value="True">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ScrollViewer.Style>

                <ItemsControl ItemsSource="{Binding HardwareGroups}" Margin="0,0,15,0">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="#1E1E1E" CornerRadius="6" Padding="15" Margin="0,0,0,15" BorderBrush="#2D2D30" BorderThickness="1">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>

                                    <!-- Group Header -->
                                    <Grid Grid.Row="0" Margin="0,0,0,12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- Category Indicator Bar -->
                                        <Border Grid.Column="0" Width="4" Height="18" CornerRadius="2" Margin="0,0,10,0">
                                            <Border.Background>
                                                <SolidColorBrush Color="{Binding CategoryColorBrush}"/>
                                            </Border.Background>
                                        </Border>

                                        <TextBlock Grid.Column="1" Text="{Binding Name}" FontSize="15" FontWeight="SemiBold" Foreground="#FFFFFF" VerticalAlignment="Center"/>
                                        <Border Grid.Column="2" Background="#252526" CornerRadius="4" Padding="8,3" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Category}" Foreground="#888888" FontSize="11" FontWeight="Bold"/>
                                        </Border>
                                    </Grid>

                                    <!-- Table Column Headers -->
                                    <Border Grid.Row="1" Background="#141415" CornerRadius="4" Padding="10,6" Margin="0,0,0,8">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="120"/>
                                                <ColumnDefinition Width="90"/>
                                                <ColumnDefinition Width="220"/>
                                                <ColumnDefinition Width="80"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="SENSOR NAME" Foreground="#777777" FontSize="10" FontWeight="Bold"/>
                                            <TextBlock Grid.Column="1" Text="CURRENT VALUE" Foreground="#777777" FontSize="10" FontWeight="Bold"/>
                                            <TextBlock Grid.Column="2" Text="STATUS" Foreground="#777777" FontSize="10" FontWeight="Bold"/>
                                            <TextBlock Grid.Column="3" Text="MIN / MAX / AVG" Foreground="#777777" FontSize="10" FontWeight="Bold"/>
                                            <TextBlock Grid.Column="4" Text="UPDATED" Foreground="#777777" FontSize="10" FontWeight="Bold" HorizontalAlignment="Right"/>
                                        </Grid>
                                    </Border>

                                    <!-- Sensor Rows -->
                                    <ItemsControl Grid.Row="2" ItemsSource="{Binding Sensors}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Background="#252526" CornerRadius="4" Padding="10,8" Margin="0,0,0,6">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Setter Property="BorderThickness" Value="1"/>
                                                            <Setter Property="BorderBrush" Value="#2D2D30"/>
                                                            <Style.Triggers>
                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                    <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                                                    <Setter Property="Background" Value="#2A2A2D"/>
                                                                </Trigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="120"/>
                                                            <ColumnDefinition Width="90"/>
                                                            <ColumnDefinition Width="220"/>
                                                            <ColumnDefinition Width="80"/>
                                                        </Grid.ColumnDefinitions>

                                                        <!-- Sensor Name & Type -->
                                                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding Name}" Foreground="#DDDDDD" FontSize="12" FontWeight="SemiBold"/>
                                                            <TextBlock Text="{Binding SensorType}" Foreground="#777777" FontSize="10"/>
                                                        </StackPanel>

                                                        <!-- Current Reading -->
                                                        <TextBlock Grid.Column="1" Text="{Binding FormattedValue}" FontSize="13" FontWeight="Bold" VerticalAlignment="Center" HorizontalAlignment="Left">
                                                            <TextBlock.Foreground>
                                                                <SolidColorBrush Color="{Binding HealthStatusBrush}"/>
                                                            </TextBlock.Foreground>
                                                        </TextBlock>

                                                        <!-- Health Status Badge -->
                                                        <Border Grid.Column="2" CornerRadius="3" Padding="6,2" HorizontalAlignment="Left" VerticalAlignment="Center" Background="#141415">
                                                            <TextBlock Text="{Binding HealthStatus}" FontSize="10" FontWeight="Bold">
                                                                <TextBlock.Foreground>
                                                                    <SolidColorBrush Color="{Binding HealthStatusBrush}"/>
                                                                </TextBlock.Foreground>
                                                            </TextBlock>
                                                        </Border>

                                                        <!-- Min / Max / Avg Summary -->
                                                        <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Left">
                                                            <TextBlock Text="Min: " Foreground="#666666" FontSize="10"/>
                                                            <TextBlock Text="{Binding FormattedMin}" Foreground="#AAAAAA" FontSize="10" Margin="0,0,10,0"/>
                                                            <TextBlock Text="Max: " Foreground="#666666" FontSize="10"/>
                                                            <TextBlock Text="{Binding FormattedMax}" Foreground="#AAAAAA" FontSize="10" Margin="0,0,10,0"/>
                                                            <TextBlock Text="Avg: " Foreground="#666666" FontSize="10"/>
                                                            <TextBlock Text="{Binding FormattedAvg}" Foreground="#AAAAAA" FontSize="10"/>
                                                        </StackPanel>

                                                        <!-- Last Updated -->
                                                        <TextBlock Grid.Column="4" Text="{Binding LastUpdated}" Foreground="#555555" FontSize="10" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <!-- ADVANCED MODE RAW DATA GRID VIEW -->
            <DataGrid ItemsSource="{Binding AllRawSensors}"
                      AutoGenerateColumns="False"
                      CanUserAddRows="False"
                      IsReadOnly="True"
                      EnableRowVirtualization="True"
                      VirtualizingPanel.IsVirtualizing="True"
                      VirtualizingPanel.VirtualizationMode="Recycling"
                      ScrollViewer.CanContentScroll="True"
                      Background="#1E1E1E"
                      RowBackground="#1E1E1E"
                      AlternatingRowBackground="#252526"
                      Foreground="#CCCCCC"
                      GridLinesVisibility="Horizontal"
                      HorizontalGridLinesBrush="#2D2D30"
                      HeadersVisibility="Column"
                      BorderThickness="1"
                      BorderBrush="#2D2D30">
                <DataGrid.Style>
                    <Style TargetType="DataGrid">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsAdvancedMode}" Value="True">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </DataGrid.Style>

                <DataGrid.ColumnHeaderStyle>
                    <Style TargetType="DataGridColumnHeader">
                        <Setter Property="Background" Value="#252526"/>
                        <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
                        <Setter Property="FontWeight" Value="Bold"/>
                        <Setter Property="Padding" Value="8,6"/>
                        <Setter Property="BorderThickness" Value="0,0,1,1"/>
                        <Setter Property="BorderBrush" Value="#2D2D30"/>
                    </Style>
                </DataGrid.ColumnHeaderStyle>

                <DataGrid.Columns>
                    <DataGridTextColumn Header="Hardware" Binding="{Binding HardwareName}" Width="1.5*"/>
                    <DataGridTextColumn Header="Hardware Type" Binding="{Binding HardwareType}" Width="*"/>
                    <DataGridTextColumn Header="Sensor Name" Binding="{Binding Name}" Width="1.5*"/>
                    <DataGridTextColumn Header="Sensor Type" Binding="{Binding SensorType}" Width="*"/>
                    <DataGridTextColumn Header="Identifier" Binding="{Binding Identifier}" Width="2*"/>
                    <DataGridTextColumn Header="Current Value" Binding="{Binding FormattedValue}" Width="*"/>
                    <DataGridTextColumn Header="Min" Binding="{Binding FormattedMin}" Width="*"/>
                    <DataGridTextColumn Header="Max" Binding="{Binding FormattedMax}" Width="*"/>
                    <DataGridTextColumn Header="Avg" Binding="{Binding FormattedAvg}" Width="*"/>
                    <DataGridTextColumn Header="Status" Binding="{Binding HealthStatus}" Width="*"/>
                    <DataGridTextColumn Header="Last Updated" Binding="{Binding LastUpdated}" Width="*"/>
                </DataGrid.Columns>
            </DataGrid>
        </Grid>
    </Grid>
</UserControl>
