<UserControl x:Class="TaskCore.Views.Graphs.NetworkCardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF">

    <StackPanel Margin="0 0 0 18">
        <Border Background="#1E1E1E" CornerRadius="4" Padding="10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="0 0 0 10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Text="{Binding AdapterName}"
                               FontSize="14"
                               FontWeight="SemiBold"
                               Foreground="#CCCCCC"
                               Grid.Column="0"
                               TextTrimming="CharacterEllipsis"
                               TextWrapping="Wrap"/>

                    <StackPanel Orientation="Horizontal" Grid.Column="1">
                        <TextBlock Text="↓ " Foreground="#00FFFF" FontSize="14" FontWeight="Bold"/>
                        <TextBlock Text="{Binding CurrentDownloadText}" Foreground="#00FFFF" FontSize="14" FontWeight="Bold"/>
                        <TextBlock Text="   " />
                        <TextBlock Text="↑ " Foreground="#FF6464" FontSize="14" FontWeight="Bold"/>
                        <TextBlock Text="{Binding CurrentUploadText}" Foreground="#FF6464" FontSize="14" FontWeight="Bold"/>
                    </StackPanel>
                </Grid>

                <lvc:CartesianChart Series="{Binding DownloadSeries}"
                                    Height="120"
                                    Background="Transparent"
                                    AnimationsSpeed="00:00:00.500"
                                    Grid.Row="1"/>

                <lvc:CartesianChart Series="{Binding UploadSeries}"
                                    Height="120"
                                    Background="Transparent"
                                    AnimationsSpeed="00:00:00.500"
                                    Grid.Row="2"
                                    Margin="0 10 0 0"/>
            </Grid>
        </Border>

        <Border Background="#1E1E1E" CornerRadius="4" Padding="15" Margin="0 10 0 0">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <Grid MinWidth="250">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Text="Status:" Foreground="#999999" FontSize="11" Grid.Column="0" Grid.Row="0"/>
                    <TextBlock Text="{Binding Status}" Foreground="#CCCCCC" FontSize="11" Grid.Column="0" Grid.Row="1" Margin="0 0 0 8"/>

                    <TextBlock Text="Link:" Foreground="#999999" FontSize="11" Grid.Column="1" Grid.Row="0"/>
                    <TextBlock Text="{Binding LinkSpeedText}" Foreground="#CCCCCC" FontSize="11" Grid.Column="1" Grid.Row="1" Margin="0 0 0 8"/>

                    <TextBlock Text="DHCP:" Foreground="#999999" FontSize="11" Grid.Column="2" Grid.Row="0"/>
                    <TextBlock Text="{Binding DhcpText}" Foreground="#CCCCCC" FontSize="11" Grid.Column="2" Grid.Row="1" Margin="0 0 0 8"/>

                    <TextBlock Text="MAC:" Foreground="#999999" FontSize="11" Grid.Column="3" Grid.Row="0"/>
                    <TextBlock Text="{Binding MacAddress}" Foreground="#CCCCCC" FontSize="11" Grid.Column="3" Grid.Row="1" Margin="0 0 0 8"/>

                    <TextBlock Text="IPv4:" Foreground="#999999" FontSize="11" Grid.Column="0" Grid.Row="2"/>
                    <TextBlock Text="{Binding Ipv4Text}" Foreground="#CCCCCC" FontSize="11" Grid.Column="0" Grid.Row="3" Grid.ColumnSpan="2" Margin="0 0 0 8" TextWrapping="Wrap"/>

                    <TextBlock Text="IPv6:" Foreground="#999999" FontSize="11" Grid.Column="2" Grid.Row="2"/>
                    <TextBlock Text="{Binding Ipv6Text}" Foreground="#CCCCCC" FontSize="11" Grid.Column="2" Grid.Row="3" Grid.ColumnSpan="2" Margin="0 0 0 8" TextWrapping="Wrap"/>

                    <TextBlock Text="Gateway:" Foreground="#999999" FontSize="11" Grid.Column="0" Grid.Row="4"/>
                    <TextBlock Text="{Binding GatewayText}" Foreground="#CCCCCC" FontSize="11" Grid.Column="0" Grid.Row="5" Grid.ColumnSpan="2" Margin="0 0 0 8" TextWrapping="Wrap"/>

                    <TextBlock Text="DNS:" Foreground="#999999" FontSize="11" Grid.Column="2" Grid.Row="4"/>
                    <TextBlock Text="{Binding DnsText}" Foreground="#CCCCCC" FontSize="11" Grid.Column="2" Grid.Row="5" Grid.ColumnSpan="2" Margin="0 0 0 8" TextWrapping="Wrap"/>
                </Grid>
            </ScrollViewer>
        </Border>
    </StackPanel>
</UserControl>
