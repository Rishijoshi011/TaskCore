<UserControl x:Class="TaskCore.Views.Graphs.GpuGraphView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:TaskCore.ViewModels.Graphs"
             xmlns:graphs="clr-namespace:TaskCore.Views.Graphs"
             Background="{StaticResource BackgroundPrimary}"
             Padding="20">

    <UserControl.DataContext>
        <vm:GpuGraphViewModel/>
    </UserControl.DataContext>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="0 0 15 0">
            <TextBlock Text="GPU Usage (%)"
                       FontSize="20"
                       FontWeight="Bold"
                       Margin="0 0 0 10"
                       Foreground="#FFDC00"/>

            <ItemsControl ItemsSource="{Binding Gpus}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <graphs:GpuCardView/>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
</UserControl>
