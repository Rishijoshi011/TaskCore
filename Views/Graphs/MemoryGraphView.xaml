<UserControl x:Class="TaskCore.Views.Graphs.MemoryGraphView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF"
             xmlns:vm="clr-namespace:TaskCore.ViewModels.Graphs"
             Background="{StaticResource BackgroundPrimary}">

    <UserControl.DataContext>
        <vm:MemoryViewModel/>
    </UserControl.DataContext>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid MinWidth="300">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Title -->
            <TextBlock Text="Memory Usage (%)"
                       FontSize="20"
                       FontWeight="Bold"
                       Margin="0 0 0 10"
                       Foreground="#00FFFF"
                       Grid.Row="0"/>

            <!-- Graph Container -->
            <Border Background="#1E1E1E" CornerRadius="4" Padding="10" Grid.Row="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    
                    <!-- Memory Name and Current Utilization -->
                    <Grid Grid.Row="0" Margin="0 0 0 15">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding TotalMemoryGB, StringFormat='{}{0:F1} GB'}"
                                   FontSize="14"
                                   FontWeight="SemiBold"
                                   Foreground="#CCCCCC"
                                   Grid.Column="0"
                                   TextTrimming="CharacterEllipsis"
                                   TextWrapping="Wrap"/>
                        <TextBlock Text="{Binding CurrentUtilization, StringFormat='{}{0:F1}%'}"
                                   FontSize="16"
                                   FontWeight="Bold"
                                   Foreground="#00FFFF"
                                   Grid.Column="1"
                                   Margin="10,0,0,0"/>
                    </Grid>

                    <!-- Chart -->
                    <lvc:CartesianChart Series="{Binding Series}"
                                        Height="200"
                                        MinHeight="150"
                                        Background="Transparent"
                                        AnimationsSpeed="00:00:00.500"
                                        Grid.Row="1"/>
                </Grid>
            </Border>

            <!-- Memory Information Panel -->
            <Border Background="#1E1E1E" CornerRadius="4" Padding="15" Margin="0 10 0 0" Grid.Row="2">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <Grid MinWidth="250">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Row 1 - Basic Info -->
                        <TextBlock Text="Used:" Foreground="#999999" FontSize="11" Grid.Column="0" Grid.Row="0" VerticalAlignment="Top"/>
                        <TextBlock Text="{Binding UsedMemoryGB, StringFormat='{}{0:F1} GB'}" Foreground="#00FFFF" FontSize="11" Grid.Column="0" Grid.Row="1" Margin="0 0 0 8" VerticalAlignment="Top"/>

                        <TextBlock Text="Available:" Foreground="#999999" FontSize="11" Grid.Column="1" Grid.Row="0" VerticalAlignment="Top"/>
                        <TextBlock Text="{Binding AvailableMemoryGB, StringFormat='{}{0:F1} GB'}" Foreground="#CCCCCC" FontSize="11" Grid.Column="1" Grid.Row="1" Margin="0 0 0 8" VerticalAlignment="Top"/>

                        <TextBlock Text="Total:" Foreground="#999999" FontSize="11" Grid.Column="2" Grid.Row="0" VerticalAlignment="Top"/>
                        <TextBlock Text="{Binding TotalMemoryGB, StringFormat='{}{0:F1} GB'}" Foreground="#CCCCCC" FontSize="11" Grid.Column="2" Grid.Row="1" Margin="0 0 0 8" VerticalAlignment="Top"/>

                        <TextBlock Text="Utilization:" Foreground="#999999" FontSize="11" Grid.Column="3" Grid.Row="0" VerticalAlignment="Top"/>
                        <TextBlock Text="{Binding CurrentUtilization, StringFormat='{}{0:F1}%'}" Foreground="#00FFFF" FontSize="11" Grid.Column="3" Grid.Row="1" Margin="0 0 0 8" VerticalAlignment="Top"/>

                        <!-- Row 2 - Speed Info -->
                        <TextBlock Text="Speed:" Foreground="#999999" FontSize="11" Grid.Column="0" Grid.Row="2" VerticalAlignment="Top"/>
                        <TextBlock Text="{Binding MemorySpeed, StringFormat='{}{0}'}" Foreground="#CCCCCC" FontSize="11" Grid.Column="0" Grid.Row="3" Margin="0 0 0 8" VerticalAlignment="Top"/>

                        <TextBlock Text="Type:" Foreground="#999999" FontSize="11" Grid.Column="1" Grid.Row="2" VerticalAlignment="Top"/>
                        <TextBlock Text="{Binding MemoryType}" Foreground="#CCCCCC" FontSize="11" Grid.Column="1" Grid.Row="3" Margin="0 0 0 8" VerticalAlignment="Top"/>

                        <TextBlock Text="Slots:" Foreground="#999999" FontSize="11" Grid.Column="2" Grid.Row="2" VerticalAlignment="Top"/>
                        <TextBlock Text="{Binding MemorySlots}" Foreground="#CCCCCC" FontSize="11" Grid.Column="2" Grid.Row="3" Margin="0 0 0 8" VerticalAlignment="Top"/>

                        <TextBlock Text="Form Factor:" Foreground="#999999" FontSize="11" Grid.Column="3" Grid.Row="2" VerticalAlignment="Top"/>
                        <TextBlock Text="{Binding FormFactor}" Foreground="#CCCCCC" FontSize="11" Grid.Column="3" Grid.Row="3" Margin="0 0 0 8" VerticalAlignment="Top"/>

                        <!-- Row 3 - Manufacturer Info -->
                        <TextBlock Text="Manufacturer:" Foreground="#999999" FontSize="11" Grid.Column="0" Grid.Row="4" VerticalAlignment="Top"/>
                        <TextBlock Text="{Binding Manufacturer}" Foreground="#CCCCCC" FontSize="11" Grid.Column="0" Grid.Row="5" Margin="0 0 0 8" VerticalAlignment="Top"/>

                        <TextBlock Text="Part Number:" Foreground="#999999" FontSize="11" Grid.Column="1" Grid.Row="4" VerticalAlignment="Top"/>
                        <TextBlock Text="{Binding PartNumber}" Foreground="#CCCCCC" FontSize="11" Grid.Column="1" Grid.Row="5" Margin="0 0 0 8" VerticalAlignment="Top"/>

                        <TextBlock Text="Serial Number:" Foreground="#999999" FontSize="11" Grid.Column="2" Grid.Row="4" VerticalAlignment="Top"/>
                        <TextBlock Text="{Binding SerialNumber}" Foreground="#CCCCCC" FontSize="11" Grid.Column="2" Grid.Row="5" Margin="0 0 0 8" VerticalAlignment="Top"/>

                        <TextBlock Text="Capacity:" Foreground="#999999" FontSize="11" Grid.Column="3" Grid.Row="4" VerticalAlignment="Top"/>
                        <TextBlock Text="{Binding Capacity}" Foreground="#CCCCCC" FontSize="11" Grid.Column="3" Grid.Row="5" Margin="0 0 0 8" VerticalAlignment="Top"/>

                        <!-- Row 4 - Technical Info -->
                        <TextBlock Text="Config Speed:" Foreground="#999999" FontSize="11" Grid.Column="0" Grid.Row="6" VerticalAlignment="Top"/>
                        <TextBlock Text="{Binding ConfiguredClockSpeed}" Foreground="#CCCCCC" FontSize="11" Grid.Column="0" Grid.Row="7" Margin="0 0 0 8" VerticalAlignment="Top"/>

                        <TextBlock Text="Data Width:" Foreground="#999999" FontSize="11" Grid.Column="1" Grid.Row="6" VerticalAlignment="Top"/>
                        <TextBlock Text="{Binding DataWidth}" Foreground="#CCCCCC" FontSize="11" Grid.Column="1" Grid.Row="7" Margin="0 0 0 8" VerticalAlignment="Top"/>

                        <TextBlock Text="Device Type:" Foreground="#999999" FontSize="11" Grid.Column="2" Grid.Row="6" VerticalAlignment="Top"/>
                        <TextBlock Text="{Binding MemoryDeviceType}" Foreground="#CCCCCC" FontSize="11" Grid.Column="2" Grid.Row="7" Margin="0 0 0 8" VerticalAlignment="Top"/>

                        <TextBlock Text="Total Width:" Foreground="#999999" FontSize="11" Grid.Column="3" Grid.Row="6" VerticalAlignment="Top"/>
                        <TextBlock Text="{Binding TotalWidth}" Foreground="#CCCCCC" FontSize="11" Grid.Column="3" Grid.Row="7" Margin="0 0 0 8" VerticalAlignment="Top"/>

                        <!-- Row 5 - Location Info -->
                        <TextBlock Text="Bank Label:" Foreground="#999999" FontSize="11" Grid.Column="0" Grid.Row="8" VerticalAlignment="Top"/>
                        <TextBlock Text="{Binding BankLabel}" Foreground="#CCCCCC" FontSize="11" Grid.Column="0" Grid.Row="9" Margin="0 0 0 8" VerticalAlignment="Top"/>

                        <TextBlock Text="Device Locator:" Foreground="#999999" FontSize="11" Grid.Column="1" Grid.Row="8" VerticalAlignment="Top"/>
                        <TextBlock Text="{Binding DeviceLocator}" Foreground="#CCCCCC" FontSize="11" Grid.Column="1" Grid.Row="9" Margin="0 0 0 8" VerticalAlignment="Top"/>

                        <TextBlock Text="Memory Tag:" Foreground="#999999" FontSize="11" Grid.Column="2" Grid.Row="8" VerticalAlignment="Top"/>
                        <TextBlock Text="{Binding MemoryTag}" Foreground="#CCCCCC" FontSize="11" Grid.Column="2" Grid.Row="9" Margin="0 0 0 8" VerticalAlignment="Top"/>

                        <TextBlock Text="Type Detail:" Foreground="#999999" FontSize="11" Grid.Column="3" Grid.Row="8" VerticalAlignment="Top"/>
                        <TextBlock Text="{Binding TypeDetail}" Foreground="#CCCCCC" FontSize="11" Grid.Column="3" Grid.Row="9" Margin="0 0 0 8" VerticalAlignment="Top"/>

                    </Grid>
                </ScrollViewer>
            </Border>

        </Grid>
    </ScrollViewer>
</UserControl>
