<UserControl x:Class="TaskCore.Views.RulesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="600" d:DesignWidth="800">

    <UserControl.Resources>
        <Style x:Key="ActionButton" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Padding" Value="12 8"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <Style x:Key="SecondaryButton" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource BackgroundSecondary}"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="Padding" Value="12 8"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <Style x:Key="DangerButton" TargetType="Button">
            <Setter Property="Background" Value="#E74C3C"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Padding" Value="8 4"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="11"/>
        </Style>
    </UserControl.Resources>

    <Grid Margin="30">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- Title -->
            <RowDefinition Height="Auto"/>
            <!-- Enable toggle & Add button + Sound controls -->
            <RowDefinition Height="Auto"/>
            <!-- Search & Filters -->
            <RowDefinition Height="*"/>
            <!-- Rules list -->
            <RowDefinition Height="Auto"/>
            <!-- Events header -->
            <RowDefinition Height="200"/>
            <!-- Events list -->
        </Grid.RowDefinitions>

        <!-- TITLE -->
        <TextBlock Text="Rules Engine"
                   Grid.Row="0"
                   FontSize="28"
                   FontWeight="Bold"
                   Foreground="{DynamicResource AccentBrush}"
                   Margin="0 0 0 20"/>

        <!-- ENABLE TOGGLE & SOUND OPTIONS -->
        <Grid Grid.Row="1" Margin="0 0 0 15">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            
            <StackPanel Grid.Column="0" VerticalAlignment="Top">
                <StackPanel Orientation="Horizontal">
                    <CheckBox IsChecked="{Binding RulesEngineEnabled}"
                              Content="Enable Rules Engine"
                              Foreground="{StaticResource TextPrimary}"
                              FontSize="14"
                              VerticalAlignment="Center"/>
                    <Control Style="{StaticResource InfoIcon}" Margin="8 0 0 0" VerticalAlignment="Center"
                               ToolTip="When enabled, TaskCore actively monitors processes&#10;and triggers actions when conditions are met.&#10;Disable to pause all rule monitoring."/>
                </StackPanel>
                <Button Content="+ Add New Rule"
                        Command="{Binding AddRuleCommand}"
                        Style="{StaticResource ActionButton}"
                        Padding="12 8"
                        FontWeight="SemiBold"
                        HorizontalAlignment="Left"
                        Margin="0 10 0 0"/>
            </StackPanel>

            <StackPanel Grid.Column="1" VerticalAlignment="Top">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Sound Alert" Foreground="{StaticResource TextSecondary}" Margin="0 0 10 0" VerticalAlignment="Center"/>
                    <Control Style="{StaticResource InfoIcon}" Margin="0 0 10 0" VerticalAlignment="Center"
                               ToolTip="Play sound when rules trigger.&#10;Choose Silent, Default beep, or Custom WAV file."/>
                    <ToggleButton IsChecked="{Binding SoundAlertEnabled}" Style="{StaticResource GreenSwitchToggle}" Margin="0 0 15 0"/>
                    <ComboBox ItemsSource="{Binding SoundModes}" 
                              SelectedItem="{Binding SelectedSoundMode}" 
                              IsEnabled="{Binding SoundAlertEnabled}"
                              Width="120"
                              Background="{StaticResource BackgroundSecondary}"
                              Foreground="{StaticResource TextPrimary}"
                              BorderBrush="{StaticResource BackgroundCard}"
                              Margin="0 0 10 0"
                              VerticalAlignment="Center"/>
                    <Button Content="Browse" 
                            Command="{Binding BrowseCustomSoundCommand}" 
                            Style="{StaticResource SmallActionButton}" 
                            Height="28"
                            IsEnabled="{Binding CanBrowseCustomSound}"/>
                </StackPanel>
                <TextBlock Text="{Binding LogsDirectoryPath}" 
                           Foreground="{StaticResource TextSecondary}"
                           FontSize="10"
                           Margin="0 5 0 0"
                           TextTrimming="CharacterEllipsis"
                           ToolTip="Location where rule trigger events are logged.&#10;Double-click to copy path to clipboard.&#10;Logs are saved as daily files (yyyy-MM-dd.log)"
                           Cursor="Hand">
                    <TextBlock.InputBindings>
                        <MouseBinding Command="{Binding CopyLogsPathCommand}" MouseAction="LeftDoubleClick"/>
                    </TextBlock.InputBindings>
                </TextBlock>
            </StackPanel>
        </Grid>

        <!-- SEARCH & FILTERS -->
        <Grid Grid.Row="2" Margin="0 0 0 10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Search Box -->
            <Border Grid.Column="0" 
                    Background="{StaticResource BackgroundSecondary}"
                    CornerRadius="4"
                    BorderBrush="{StaticResource BackgroundCard}"
                    BorderThickness="1"
                    Padding="8 4">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" 
                               Text="🔍" 
                               FontSize="14" 
                               Foreground="{StaticResource TextSecondary}"
                               VerticalAlignment="Center"
                               Margin="0 0 8 0"/>
                    <TextBox Grid.Column="1"
                             Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                             Background="Transparent"
                             BorderThickness="0"
                             Foreground="{StaticResource TextPrimary}"
                             VerticalAlignment="Center"
                             FontSize="13"
                             Padding="0"
                             ToolTip="Search rules by name, process, condition, or action"/>
                    <Button Grid.Column="2"
                            Content="✕"
                            Command="{Binding ClearSearchCommand}"
                            Visibility="{Binding SearchText, Converter={StaticResource StringToVisibilityConverter}}"
                            Background="Transparent"
                            Foreground="{StaticResource TextSecondary}"
                            BorderThickness="0"
                            FontSize="12"
                            Padding="4 0"
                            Cursor="Hand"/>
                </Grid>
            </Border>

            <!-- Active Only Toggle -->
            <CheckBox Grid.Column="1"
                      Content="Active only"
                      IsChecked="{Binding ShowActiveOnly, Mode=TwoWay}"
                      Foreground="{StaticResource TextSecondary}"
                      FontSize="12"
                      VerticalAlignment="Center"
                      Margin="15 0"/>

            <!-- Rules Count -->
            <TextBlock Grid.Column="2"
                       VerticalAlignment="Center"
                       FontSize="12"
                       Foreground="{StaticResource TextSecondary}">
                <TextBlock.Text>
                    <MultiBinding StringFormat="{}{0} / {1} rules">
                        <Binding Path="FilteredRulesCount"/>
                        <Binding Path="RulesCount"/>
                    </MultiBinding>
                </TextBlock.Text>
            </TextBlock>
        </Grid>

        <!-- RULES LIST -->
        <Border Grid.Row="3"
                Background="{StaticResource BackgroundSecondary}"
                CornerRadius="8"
                Padding="0"
                BorderBrush="{StaticResource BackgroundCard}"
                BorderThickness="1">

            <Grid>
                <!-- Empty state - no rules at all -->
                <TextBlock Text="No rules configured. Click 'Add New Rule' to create one."
                           Foreground="{StaticResource TextSecondary}"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           Visibility="{Binding HasRules, Converter={StaticResource InverseBoolToVisibilityConverter}}"/>

                <!-- No search results state -->
                <TextBlock Text="No rules match your search."
                           Foreground="{StaticResource TextSecondary}"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           Visibility="{Binding NoRulesFound, Converter={StaticResource BoolToVisibilityConverter}}"/>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding FilteredRules}" Padding="8">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{StaticResource BackgroundPrimary}"
                                        CornerRadius="4"
                                        Margin="0 2"
                                        Padding="8 6"
                                        BorderBrush="{StaticResource BackgroundCard}"
                                        BorderThickness="1">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- Rule Info -->
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="{Binding Name}"
                                                       FontWeight="Bold"
                                                       FontSize="13"
                                                       Foreground="{StaticResource TextPrimary}"/>
                                            <TextBlock FontSize="10"
                                                       Foreground="{StaticResource TextSecondary}"
                                                       Margin="0 2 0 0">
                                                <TextBlock.Text>
                                                    <MultiBinding StringFormat="{}{0} → {1}">
                                                        <Binding Path="ConditionType" Converter="{StaticResource EnumToDescriptionConverter}"/>
                                                        <Binding Path="ActionType" Converter="{StaticResource EnumToDescriptionConverter}"/>
                                                    </MultiBinding>
                                                </TextBlock.Text>
                                            </TextBlock>
                                            <TextBlock Text="{Binding GetConditionDescription}"
                                                       FontSize="9"
                                                       Foreground="{DynamicResource AccentBrush}"
                                                       Margin="0 1 0 0"/>
                                            <TextBlock Text="{Binding GetActionDescription}"
                                                       FontSize="9"
                                                       Foreground="{StaticResource TextSecondary}"
                                                       Margin="0 1 0 0"/>
                                            <TextBlock Text="{Binding GetNotificationModeDescription}"
                                                       FontSize="9"
                                                       Foreground="{DynamicResource AccentBrush}"
                                                       Margin="0 1 0 0"
                                                       FontStyle="Italic"/>
                                        </StackPanel>

                                        <!-- Status (Clickable to toggle) - BIGGER -->
                                        <Button Grid.Column="1"
                                                Content="{Binding IsEnabled, Converter={StaticResource BoolToStatusConverter}}"
                                                Command="{Binding DataContext.ToggleRuleEnabledCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"
                                                Background="{Binding IsEnabled, Converter={StaticResource BoolToBrushConverter}}"
                                                Foreground="White"
                                                FontSize="13"
                                                FontWeight="Bold"
                                                Padding="12 8"
                                                Margin="10 0"
                                                MinWidth="50"
                                                VerticalAlignment="Center"
                                                BorderThickness="0"
                                                Cursor="Hand"
                                                BorderBrush="Transparent">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Border Background="{TemplateBinding Background}" 
                                                            CornerRadius="4"
                                                            Padding="{TemplateBinding Padding}">
                                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </Border>
                                                </ControlTemplate>
                                            </Button.Template>
                                        </Button>

                                        <!-- Edit -->
                                        <Button Grid.Column="2"
                                                Content="Edit"
                                                Command="{Binding DataContext.EditRuleCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"
                                                Style="{StaticResource SmallActionButton}"
                                                Height="28"
                                                Margin="5 0"/>

                                        <!-- Delete -->
                                        <Button Grid.Column="3"
                                                Content="Delete"
                                                Command="{Binding DataContext.DeleteRuleCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"
                                                Style="{StaticResource SmallActionButton}"
                                                Height="28"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Border>

        <!-- EVENTS HEADER -->
        <Grid Grid.Row="4" Margin="0 20 0 10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0"
                       Text="Recent Triggers"
                       FontSize="18"
                       FontWeight="Bold"
                       Foreground="{StaticResource TextPrimary}"/>

            <Button Grid.Column="1"
                    Content="Refresh"
                    Command="{Binding RefreshEventsCommand}"
                    Style="{StaticResource SmallActionButton}"
                    Height="28"
                    Margin="0 0 5 0"/>

            <Button Grid.Column="2"
                    Content="Clear"
                    Command="{Binding ClearEventsCommand}"
                    Style="{StaticResource SmallActionButton}"
                    Height="28"/>
        </Grid>

        <!-- EVENTS LIST -->
        <Border Grid.Row="5"
                Background="{StaticResource BackgroundSecondary}"
                CornerRadius="8"
                Padding="0"
                BorderBrush="{StaticResource BackgroundCard}"
                BorderThickness="1">

            <Grid>
                <!-- Empty state -->
                <TextBlock Text="No rule triggers yet."
                           Foreground="{StaticResource TextSecondary}"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           Visibility="{Binding RecentEvents.Count, Converter={StaticResource CountToVisibilityConverter}}"/>

                <!-- Events List -->
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding RecentEvents}" Padding="10">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{StaticResource BackgroundPrimary}"
                                        CornerRadius="4"
                                        Margin="0 3"
                                        Padding="10"
                                        BorderBrush="{StaticResource BackgroundCard}"
                                        BorderThickness="1">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Grid.Column="0"
                                                   Text="{Binding TriggeredAt, StringFormat='{}{0:HH:mm:ss}'}"
                                                   FontSize="11"
                                                   Foreground="{StaticResource TextSecondary}"
                                                   Width="60"/>

                                        <TextBlock Grid.Column="1"
                                                   Text="{Binding Description}"
                                                   FontSize="12"
                                                   Foreground="{StaticResource TextPrimary}"
                                                   TextTrimming="CharacterEllipsis"
                                                   Margin="10 0"/>

                                        <TextBlock Grid.Column="2"
                                                   Text="{Binding ActionResult}"
                                                   FontSize="10"
                                                   Foreground="{DynamicResource AccentBrush}"
                                                   FontStyle="Italic"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Border>

        <!-- EDIT RULE MODAL -->
        <Border Grid.Row="0" Grid.RowSpan="6"
                Background="#80000000"
                Visibility="{Binding IsEditingRule, Converter={StaticResource BoolToVisibilityConverter}, FallbackValue=Collapsed}">
            <Border Background="{StaticResource BackgroundPrimary}"
                    CornerRadius="8"
                    Padding="25"
                    Width="500"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Center"
                    BorderBrush="{StaticResource BackgroundCard}"
                    BorderThickness="1">
                <StackPanel>
                    <Grid Margin="0 0 0 20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        
                        <TextBlock Grid.Column="0"
                                   Text="{Binding SelectedRule, Converter={StaticResource NullToTextConverter}, ConverterParameter='Edit Rule|New Rule'}"
                                   FontSize="20"
                                   FontWeight="Bold"
                                   Foreground="{DynamicResource AccentBrush}"
                                   VerticalAlignment="Center"/>
                        
                        <Button Grid.Column="1"
                                Content="✕"
                                Command="{Binding CancelEditCommand}"
                                Background="Transparent"
                                Foreground="{StaticResource TextSecondary}"
                                BorderThickness="0"
                                FontSize="18"
                                Padding="5 0"
                                Cursor="Hand"/>
                    </Grid>

                    <!-- Rule Name -->
                    <TextBlock Text="Rule Name" Foreground="{StaticResource TextSecondary}" FontSize="11" Margin="0 0 0 4"/>
                    <TextBox Text="{Binding EditRuleName}"
                             Background="{StaticResource BackgroundSecondary}"
                             Foreground="{StaticResource TextPrimary}"
                             BorderBrush="{StaticResource BackgroundCard}"
                             Padding="10 8"
                             Margin="0 0 0 18"/>

                    <!-- CONDITION SECTION -->
                    <Grid Margin="0 0 0 12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        
                        <!-- Condition Type -->
                        <StackPanel Grid.Column="0">
                            <StackPanel Orientation="Horizontal" Margin="0 0 0 4">
                                <TextBlock Text="Condition" Foreground="{StaticResource TextSecondary}" FontSize="11"/>
                                <Control Style="{StaticResource InfoIcon}" Margin="4 0 0 0"
                                           ToolTip="What condition to check:&#10;• CPU Usage Above - When process CPU exceeds threshold&#10;• Memory Above - When process RAM exceeds threshold&#10;• Process Running - When target process starts&#10;• Process Not Running - When target process stops"/>
                            </StackPanel>
                            <ComboBox ItemsSource="{Binding ConditionTypes}"
                                      SelectedItem="{Binding EditConditionType}"
                                      Background="{StaticResource BackgroundSecondary}"
                                      Foreground="{StaticResource TextPrimary}"
                                      BorderBrush="{StaticResource BackgroundCard}"
                                      Padding="8">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Converter={StaticResource EnumToDescriptionConverter}}"/>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </StackPanel>

                        <!-- Threshold (for CPU/Memory) -->
                        <StackPanel Grid.Column="2" Visibility="{Binding EditConditionType, Converter={StaticResource ConditionToVisibilityConverter}}">
                            <StackPanel Orientation="Horizontal" Margin="0 0 0 4">
                                <TextBlock Text="Threshold" Foreground="{StaticResource TextSecondary}" FontSize="11"/>
                                <Control Style="{StaticResource InfoIcon}" Margin="4 0 0 0"
                                           ToolTip="Value that triggers the condition:&#10;• For CPU: Percentage (0-100)&#10;• For Memory: Megabytes (MB)&#10;Example: 80 = 80% CPU or 80 MB RAM"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <TextBox Text="{Binding EditThresholdValue}"
                                         Background="{StaticResource BackgroundSecondary}"
                                         Foreground="{StaticResource TextPrimary}"
                                         BorderBrush="{StaticResource BackgroundCard}"
                                         Padding="10 8"
                                         Width="70"/>
                                <TextBlock Text="% / MB"
                                           Foreground="{StaticResource TextSecondary}"
                                           FontSize="11"
                                           VerticalAlignment="Center"
                                           Margin="8 0 0 0"/>
                            </StackPanel>
                        </StackPanel>
                    </Grid>

                    <!-- Target Process -->
                    <StackPanel Orientation="Horizontal" Margin="0 0 0 4">
                        <TextBlock Text="Target Process (optional)" Foreground="{StaticResource TextSecondary}" FontSize="11"/>
                        <Control Style="{StaticResource InfoIcon}" Margin="4 0 0 0"
                                   ToolTip="Process name to monitor. Leave empty to monitor all processes.&#10;Examples: chrome, msedge, notepad&#10;No need to include .exe extension"/>
                    </StackPanel>
                    <TextBox Text="{Binding EditTargetProcessName}"
                             Background="{StaticResource BackgroundSecondary}"
                             Foreground="{StaticResource TextPrimary}"
                             BorderBrush="{StaticResource BackgroundCard}"
                             Padding="10 8"
                             Margin="0 0 0 18"/>

                    <!-- ACTION SECTION -->
                    <Grid Margin="0 0 0 12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        
                        <!-- Action Type -->
                        <StackPanel Grid.Column="0">
                            <StackPanel Orientation="Horizontal" Margin="0 0 0 4">
                                <TextBlock Text="Action" Foreground="{StaticResource TextSecondary}" FontSize="11"/>
                                <Control Style="{StaticResource InfoIcon}" Margin="4 0 0 0"
                                           ToolTip="What action to take when rule triggers:&#10;• Show Notification - Display toast popup&#10;• Kill Process - Terminate the process&#10;• Set Priority - Change process priority&#10;• Log to File - Record event to log file"/>
                            </StackPanel>
                            <ComboBox ItemsSource="{Binding ActionTypes}"
                                      SelectedItem="{Binding EditActionType}"
                                      Background="{StaticResource BackgroundSecondary}"
                                      Foreground="{StaticResource TextPrimary}"
                                      BorderBrush="{StaticResource BackgroundCard}"
                                      Padding="8">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Converter={StaticResource EnumToDescriptionConverter}}"/>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </StackPanel>

                        <!-- Priority Level (for SetPriority) -->
                        <StackPanel Grid.Column="2" Visibility="{Binding EditActionType, Converter={StaticResource ActionToVisibilityConverter}}">
                            <StackPanel Orientation="Horizontal" Margin="0 0 0 4">
                                <TextBlock Text="Priority" Foreground="{StaticResource TextSecondary}" FontSize="11"/>
                                <Control Style="{StaticResource InfoIcon}" Margin="4 0 0 0"
                                           ToolTip="Process priority levels (Windows):&#10;• Low - Background tasks&#10;• BelowNormal - Less important&#10;• Normal - Default&#10;• AboveNormal - Higher preference&#10;• High - Important tasks&#10;• RealTime - Critical (use with caution)"/>
                            </StackPanel>
                            <ComboBox ItemsSource="{Binding PriorityOptions}"
                                      SelectedItem="{Binding EditActionParameter}"
                                      Background="{StaticResource BackgroundSecondary}"
                                      Foreground="{StaticResource TextPrimary}"
                                      BorderBrush="{StaticResource BackgroundCard}"
                                      Padding="8"/>
                        </StackPanel>
                    </Grid>

                    <!-- TIMING SECTION -->
                    <Grid Margin="0 0 0 15">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        
                        <!-- Duration -->
                        <StackPanel Grid.Column="0">
                            <StackPanel Orientation="Horizontal" Margin="0 0 0 4">
                                <TextBlock Text="Duration (sec)" Foreground="{StaticResource TextSecondary}" FontSize="11"/>
                                <Control Style="{StaticResource InfoIcon}" Margin="4 0 0 0"
                                           ToolTip="How long the condition must stay true before triggering the action.&#10;Example: CPU > 80% for 5 seconds → then trigger action."/>
                            </StackPanel>
                            <TextBox Text="{Binding EditDurationSeconds}"
                                     Background="{StaticResource BackgroundSecondary}"
                                     Foreground="{StaticResource TextPrimary}"
                                     BorderBrush="{StaticResource BackgroundCard}"
                                     Padding="10 8"/>
                        </StackPanel>

                        <!-- Cooldown -->
                        <StackPanel Grid.Column="2">
                            <StackPanel Orientation="Horizontal" Margin="0 0 0 4">
                                <TextBlock Text="Cooldown (sec)" Foreground="{StaticResource TextSecondary}" FontSize="11"/>
                                <Control Style="{StaticResource InfoIcon}" Margin="4 0 0 0"
                                           ToolTip="How long to wait after triggering before the rule can trigger again.&#10;Prevents spam notifications. Example: After trigger, wait 60s before checking again."/>
                            </StackPanel>
                            <TextBox Text="{Binding EditCooldownSeconds}"
                                     Background="{StaticResource BackgroundSecondary}"
                                     Foreground="{StaticResource TextPrimary}"
                                     BorderBrush="{StaticResource BackgroundCard}"
                                     Padding="10 8"/>
                        </StackPanel>

                        <!-- Notification Mode -->
                        <StackPanel Grid.Column="4">
                            <StackPanel Orientation="Horizontal" Margin="0 0 0 4">
                                <TextBlock Text="Notify Mode" Foreground="{StaticResource TextSecondary}" FontSize="11"/>
                                <Control Style="{StaticResource InfoIcon}" Margin="4 0 0 0"
                                           ToolTip="How you want to be notified when the rule triggers:&#10;• Silent - No notification&#10;• Toast Only - Windows toast popup only&#10;• Sound Only - Alert sound only&#10;• Toast + Sound - Both toast and sound"/>
                            </StackPanel>
                            <ComboBox ItemsSource="{Binding NotificationModes}"
                                      SelectedItem="{Binding EditNotificationMode}"
                                      Background="{StaticResource BackgroundSecondary}"
                                      Foreground="{StaticResource TextPrimary}"
                                      BorderBrush="{StaticResource BackgroundCard}"
                                      Padding="8">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Converter={StaticResource EnumToDescriptionConverter}}"/>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </StackPanel>
                    </Grid>

                    <!-- Buttons -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0 10 0 0">
                        <Button Content="Cancel"
                                Command="{Binding CancelEditCommand}"
                                Style="{StaticResource SecondaryButton}"
                                Padding="15 10"
                                Margin="0 0 10 0"/>
                        <Button Content="Save Rule"
                                Command="{Binding SaveRuleCommand}"
                                Style="{StaticResource ActionButton}"
                                Padding="20 10"
                                FontWeight="SemiBold"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Border>
    </Grid>
</UserControl>
