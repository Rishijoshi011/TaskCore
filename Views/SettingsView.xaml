<UserControl x:Class="TaskCore.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:TaskCore.ViewModels"
             mc:Ignorable="d"
             Background="{StaticResource BackgroundPrimary}"
             Padding="30">

    <UserControl.DataContext>
        <vm:SettingsViewModel/>
    </UserControl.DataContext>

    <d:UserControl.DataContext>
        <vm:SettingsViewModel/>
    </d:UserControl.DataContext>

    <Grid>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ===== HEADER ===== -->
        <StackPanel Grid.Row="0" Margin="0 0 0 0">
            <TextBlock Text="Settings"
                       FontSize="28"
                       FontWeight="Bold"
                       Foreground="{DynamicResource AccentBrush}"/>

            <TextBlock Text="{Binding AppVersion}"
                       FontSize="12"
                       Foreground="{StaticResource TextSecondary}"
                       Margin="0 6 0 0"/>
        </StackPanel>

        <!-- ===== CONTENT CARD ===== -->
        <Border Style="{StaticResource CardPanel}"
                Grid.Row="1"
                VerticalAlignment="Stretch"
                HorizontalAlignment="Stretch"
                BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1">

            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="0 0 0 0">
                <StackPanel Margin="0 0 15 0">

                    <TextBlock Text="Application Settings" FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}" Margin="0 0 0 15"/>

                    <Grid Margin="0 0 0 15">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Auto-Start with Windows" Foreground="{StaticResource TextPrimary}" FontSize="13" VerticalAlignment="Center"/>
                                <Control Style="{StaticResource InfoIcon}" Margin="6 0 0 0" VerticalAlignment="Center"
                                           ToolTip="Automatically start TaskCore when Windows boots.&#10;Adds an entry to Windows Registry (HKCU\Run)."/>
                            </StackPanel>
                            <TextBlock Text="Adds/removes registry startup entry" Foreground="{StaticResource TextSecondary}" FontSize="11"/>
                        </StackPanel>

                        <ToggleButton Grid.Column="1" IsChecked="{Binding AutoStartWithWindows}" Style="{StaticResource GreenSwitchToggle}" Margin="10 0 0 0"/>
                    </Grid>

                    <Grid Margin="0 0 0 15">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Start Minimized to Tray" Foreground="{StaticResource TextPrimary}" FontSize="13" VerticalAlignment="Center"/>
                                <Control Style="{StaticResource InfoIcon}" Margin="6 0 0 0" VerticalAlignment="Center"
                                           ToolTip="Launch TaskCore in the background (system tray) on startup without opening the main window.&#10;Double-click system tray icon to view."/>
                            </StackPanel>
                            <TextBlock Text="Opens in background silently" Foreground="{StaticResource TextSecondary}" FontSize="11"/>
                        </StackPanel>

                        <ToggleButton Grid.Column="1" IsChecked="{Binding StartMinimized}" Style="{StaticResource GreenSwitchToggle}" Margin="10 0 0 0"/>
                    </Grid>

                    <Grid Margin="0 0 0 15">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Close button should minimize the window" Foreground="{StaticResource TextPrimary}" FontSize="13" VerticalAlignment="Center"/>
                                <Control Style="{StaticResource InfoIcon}" Margin="6 0 0 0" VerticalAlignment="Center"
                                           ToolTip="When enabled, clicking X minimizes to system tray instead of closing.&#10;Right-click tray icon to fully exit."/>
                            </StackPanel>
                            <TextBlock Text="When enabled, closing the window minimizes it to the system tray" Foreground="{StaticResource TextSecondary}" FontSize="11"/>
                        </StackPanel>

                        <ToggleButton Grid.Column="1" IsChecked="{Binding MinimizeToTray}" Style="{StaticResource GreenSwitchToggle}" Margin="10 0 0 0"/>
                    </Grid>

                    <Grid Margin="0 0 0 15">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="220"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Refresh Interval" Foreground="{StaticResource TextPrimary}" FontSize="13" VerticalAlignment="Center"/>
                                <Control Style="{StaticResource InfoIcon}" Margin="6 0 0 0" VerticalAlignment="Center"
                                           ToolTip="How often to refresh process data and graphs.&#10;Lower = more real-time but higher CPU usage.&#10;Higher = less CPU usage but more delay."/>
                            </StackPanel>
                            <TextBlock Text="Controls how often graphs/process list refresh" Foreground="{StaticResource TextSecondary}" FontSize="11"/>
                        </StackPanel>

                        <ComboBox Grid.Column="1"
                                  ItemsSource="{Binding RefreshIntervals}"
                                  SelectedValuePath="ValueMs"
                                  DisplayMemberPath="Label"
                                  SelectedValue="{Binding RefreshIntervalMs}"
                                  Height="28"
                                  Margin="10 0 0 0"/>
                    </Grid>

                    <Grid Margin="0 0 0 15">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Prefer Admin for Protected Actions" Foreground="{StaticResource TextPrimary}" FontSize="13" VerticalAlignment="Center"/>
                                <Control Style="{StaticResource InfoIcon}" Margin="6 0 0 0" VerticalAlignment="Center"
                                           ToolTip="Some processes (system, antivirus) require admin rights to kill.&#10;When enabled, TaskCore will prompt to restart as Admin."/>
                            </StackPanel>
                            <TextBlock Text="When needed (e.g., killing protected processes), you can relaunch elevated" Foreground="{StaticResource TextSecondary}" FontSize="11" TextWrapping="Wrap"/>
                        </StackPanel>

                        <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="10 0 0 0">
                            <ToggleButton IsChecked="{Binding PreferAdminForProtectedActions}" Style="{StaticResource GreenSwitchToggle}"/>
                            <Button Content="Relaunch as Admin" Command="{Binding RelaunchAsAdminCommand}" Click="RelaunchAsAdmin_Click" Height="32" Margin="10 0 0 0" Style="{StaticResource ActionButton}"/>
                        </StackPanel>
                    </Grid>

                    <Grid Margin="0 0 0 15">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Always Run as Administrator" Foreground="{StaticResource TextPrimary}" FontSize="13" VerticalAlignment="Center"/>
                                <Control Style="{StaticResource InfoIcon}" Margin="6 0 0 0" VerticalAlignment="Center"
                                           ToolTip="Automatically restart TaskCore as administrator on startup.&#10;Requires UAC approval on first launch."/>
                            </StackPanel>
                            <TextBlock Text="Automatically relaunch as admin on startup (prompts for UAC on first run)" Foreground="{StaticResource TextSecondary}" FontSize="11" TextWrapping="Wrap"/>
                        </StackPanel>

                        <ToggleButton Grid.Column="1" IsChecked="{Binding AlwaysRunAsAdministrator}" Style="{StaticResource GreenSwitchToggle}" Margin="10 0 0 0"/>
                    </Grid>

                    <Grid Margin="0 0 0 15">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Minimal Watchdog Mode" Foreground="{DynamicResource AccentBrush}" FontSize="13" VerticalAlignment="Center" FontWeight="SemiBold"/>
                                <Control Style="{StaticResource InfoIcon}" Margin="6 0 0 0" VerticalAlignment="Center"
                                           ToolTip="Reduces memory usage by disabling Dashboard, Processes, Graphs, and Session Tracker.&#10;Only Rules and Settings tabs remain available.&#10;Use this mode if you only need the Rules Engine functionality."/>
                            </StackPanel>
                            <TextBlock Text="Disable heavy monitoring features to use only Rules Engine" Foreground="{StaticResource TextSecondary}" FontSize="11"/>
                        </StackPanel>

                        <ToggleButton Grid.Column="1" IsChecked="{Binding WatchdogMode}" Style="{StaticResource GreenSwitchToggle}" Margin="10 0 0 0"/>
                    </Grid>

                    <Separator Margin="0 0 0 15"/>

                    <TextBlock Text="Theme" FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}" Margin="0 0 0 15"/>

                    <StackPanel Margin="0 0 0 15">
                        <TextBlock Text="Accent Color" Foreground="{StaticResource TextPrimary}" FontSize="13" Margin="0 0 0 8"/>
                        <TextBlock Text="Choose your preferred accent color for buttons, highlights, and active states" Foreground="{StaticResource TextSecondary}" FontSize="11" Margin="0 -4 0 10"/>

                        <!-- Color Swatches -->
                        <WrapPanel Margin="0 0 0 10">
                            <Button Width="32" Height="32" Margin="0 0 8 8"
                                    Background="#FF9A4DFF" BorderBrush="{StaticResource TextSecondary}" BorderThickness="1"
                                    ToolTip="Purple (Default)"
                                    Command="{Binding SetPresetAccentColorCommand}" CommandParameter="#FF9A4DFF">
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="Button">
                                                    <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4">
                                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </Border>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </Button.Style>
                            </Button>
                            <Button Width="32" Height="32" Margin="0 0 8 8"
                                    Background="#FF00D4AA" BorderBrush="{StaticResource TextSecondary}" BorderThickness="1"
                                    ToolTip="Cyan"
                                    Command="{Binding SetPresetAccentColorCommand}" CommandParameter="#FF00D4AA">
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="Button">
                                                    <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4">
                                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </Border>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </Button.Style>
                            </Button>
                            <Button Width="32" Height="32" Margin="0 0 8 8"
                                    Background="#FFFF4D9A" BorderBrush="{StaticResource TextSecondary}" BorderThickness="1"
                                    ToolTip="Pink"
                                    Command="{Binding SetPresetAccentColorCommand}" CommandParameter="#FFFF4D9A">
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="Button">
                                                    <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4">
                                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </Border>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </Button.Style>
                            </Button>
                            <Button Width="32" Height="32" Margin="0 0 8 8"
                                    Background="#FFFF4D4D" BorderBrush="{StaticResource TextSecondary}" BorderThickness="1"
                                    ToolTip="Red"
                                    Command="{Binding SetPresetAccentColorCommand}" CommandParameter="#FFFF4D4D">
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="Button">
                                                    <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4">
                                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </Border>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </Button.Style>
                            </Button>
                            <Button Width="32" Height="32" Margin="0 0 8 8"
                                    Background="#FF4DFF4D" BorderBrush="{StaticResource TextSecondary}" BorderThickness="1"
                                    ToolTip="Green"
                                    Command="{Binding SetPresetAccentColorCommand}" CommandParameter="#FF4DFF4D">
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="Button">
                                                    <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4">
                                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </Border>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </Button.Style>
                            </Button>
                            <Button Width="32" Height="32" Margin="0 0 8 8"
                                    Background="#FFFFA500" BorderBrush="{StaticResource TextSecondary}" BorderThickness="1"
                                    ToolTip="Orange"
                                    Command="{Binding SetPresetAccentColorCommand}" CommandParameter="#FFFFA500">
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="Button">
                                                    <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4">
                                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </Border>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </Button.Style>
                            </Button>
                            <Button Width="32" Height="32" Margin="0 0 8 8"
                                    Background="#FF4D9AFF" BorderBrush="{StaticResource TextSecondary}" BorderThickness="1"
                                    ToolTip="Blue"
                                    Command="{Binding SetPresetAccentColorCommand}" CommandParameter="#FF4D9AFF">
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="Button">
                                                    <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4">
                                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </Border>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </Button.Style>
                            </Button>
                            <Button Width="32" Height="32" Margin="0 0 8 8"
                                    Background="#FFFFD700" BorderBrush="{StaticResource TextSecondary}" BorderThickness="1"
                                    ToolTip="Gold"
                                    Command="{Binding SetPresetAccentColorCommand}" CommandParameter="#FFFFD700">
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="Button">
                                                    <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4">
                                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </Border>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </Button.Style>
                            </Button>
                        </WrapPanel>

                        <!-- Custom Color Input -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Custom Hex:" Foreground="{StaticResource TextSecondary}" FontSize="12" VerticalAlignment="Center" Margin="0 0 10 0"/>
                            <TextBox Grid.Column="1" Text="{Binding AccentColor, UpdateSourceTrigger=LostFocus}" 
                                     Background="{StaticResource BackgroundSecondary}" Foreground="{StaticResource TextPrimary}" 
                                     BorderBrush="{StaticResource BackgroundCard}" Padding="8 4" FontSize="12"
                                     ToolTip="Enter hex color: #RRGGBB (e.g., #FF5733) or #AARRGGBB"/>
                        </Grid>
                    </StackPanel>

                    <Separator Margin="0 0 0 15"/>

                    <TextBlock Text="Automation Watchdog"
                               FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}" Margin="0 0 0 15"/>

                    <Grid Margin="0 0 0 15">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Enable Automation Watchdog" Foreground="{StaticResource TextPrimary}" FontSize="13" VerticalAlignment="Center" FontWeight="SemiBold"/>
                                <Control Style="{StaticResource InfoIcon}" Margin="6 0 0 0" VerticalAlignment="Center"
                                           ToolTip="Runs background automation to recover from freezes/high CPU and reduce runaway processes. All actions are logged."/>
                            </StackPanel>
                            <TextBlock Text="Auto-recovery actions (always logged)" Foreground="{StaticResource TextSecondary}" FontSize="11"/>
                        </StackPanel>

                        <ToggleButton Grid.Column="1" IsChecked="{Binding AutomationWatchdogEnabled}" Style="{StaticResource GreenSwitchToggle}" Margin="10 0 0 0"/>
                    </Grid>

                    <Grid Margin="0 0 0 10" IsEnabled="{Binding AutomationWatchdogEnabled}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Explorer freeze ? restart" Foreground="{StaticResource TextPrimary}" FontSize="13" VerticalAlignment="Center"/>
                                <Control Style="{StaticResource InfoIcon}" Margin="6 0 0 0" VerticalAlignment="Center"
                                           ToolTip="If explorer.exe is not responding, TaskCore will restart it. All actions are logged."/>
                            </StackPanel>
                            <TextBlock Text="Restarts explorer.exe when it stops responding" Foreground="{StaticResource TextSecondary}" FontSize="11"/>
                        </StackPanel>

                        <ToggleButton Grid.Column="1" IsChecked="{Binding AutomationRestartExplorerEnabled}" Style="{StaticResource GreenSwitchToggle}" Margin="10 0 0 0"/>
                    </Grid>

                    <Grid Margin="0 0 0 10" IsEnabled="{Binding AutomationWatchdogEnabled}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="CPU stuck at 100% ? lower priority then kill" Foreground="{StaticResource TextPrimary}" FontSize="13" VerticalAlignment="Center"/>
                                <Control Style="{StaticResource InfoIcon}" Margin="6 0 0 0" VerticalAlignment="Center"
                                           ToolTip="If a single process stays near 100% CPU for ~10s, TaskCore lowers its priority. If it stays stuck, TaskCore kills it. All actions are logged."/>
                            </StackPanel>
                            <TextBlock Text="Auto-mitigates CPU offenders" Foreground="{StaticResource TextSecondary}" FontSize="11"/>
                        </StackPanel>

                        <ToggleButton Grid.Column="1" IsChecked="{Binding AutomationCpuMitigationEnabled}" Style="{StaticResource GreenSwitchToggle}" Margin="10 0 0 0"/>
                    </Grid>

                    <Grid Margin="0 0 0 15" IsEnabled="{Binding AutomationWatchdogEnabled}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Edge WebView2 extras ? kill" Foreground="{StaticResource TextPrimary}" FontSize="13" VerticalAlignment="Center"/>
                                <Control Style="{StaticResource InfoIcon}" Margin="6 0 0 0" VerticalAlignment="Center"
                                           ToolTip="If msedgewebview2.exe spawns too many instances, TaskCore kills extras. All actions are logged."/>
                            </StackPanel>
                            <TextBlock Text="Kills extra msedgewebview2.exe instances when count is too high" Foreground="{StaticResource TextSecondary}" FontSize="11" TextWrapping="Wrap"/>
                        </StackPanel>

                        <ToggleButton Grid.Column="1" IsChecked="{Binding AutomationEdgeWebViewCleanupEnabled}" Style="{StaticResource GreenSwitchToggle}" Margin="10 0 0 0"/>
                    </Grid>

                    <TextBlock Text="Session Tracker - Process Filter" 
                               FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}" Margin="0 0 0 15"
                               Visibility="{Binding WatchdogMode, Converter={StaticResource InverseBoolToVisibilityConverter}}"/>
                    <TextBlock Text="Choose which processes appear in the 'Currently Running' table" 
                               Foreground="{StaticResource TextSecondary}" FontSize="11" Margin="0 -10 0 15"
                               Visibility="{Binding WatchdogMode, Converter={StaticResource InverseBoolToVisibilityConverter}}"/>

                    <StackPanel Margin="0 0 0 15"
                                Visibility="{Binding WatchdogMode, Converter={StaticResource InverseBoolToVisibilityConverter}}">
                        <RadioButton Content="Show all processes" 
                                     IsChecked="{Binding ProcessFilterMode, Converter={StaticResource EnumToBoolConverter}, ConverterParameter=0}"
                                     Foreground="{StaticResource TextPrimary}" Margin="0 0 0 8"/>
                        <TextBlock Text="Show every tracked process including system apps" Foreground="{StaticResource TextSecondary}" FontSize="10" Margin="20 -8 0 8"/>

                        <RadioButton Content="Exclude Windows system processes" 
                                     IsChecked="{Binding ProcessFilterMode, Converter={StaticResource EnumToBoolConverter}, ConverterParameter=1}"
                                     Foreground="{StaticResource TextPrimary}" Margin="0 0 0 8"/>
                        <TextBlock Text="Hide apps in Windows directory and system services (recommended)" Foreground="{StaticResource TextSecondary}" FontSize="10" Margin="20 -8 0 8"/>

                        <RadioButton Content="Only selected processes" 
                                     IsChecked="{Binding ProcessFilterMode, Converter={StaticResource EnumToBoolConverter}, ConverterParameter=2}"
                                     Foreground="{StaticResource TextPrimary}" Margin="0 0 0 8"/>
                        <TextBlock Text="Show only apps you explicitly select below" Foreground="{StaticResource TextSecondary}" FontSize="10" Margin="20 -8 0 0"/>
                    </StackPanel>

                    <!-- Selected Processes Management (visible when mode=2 and not in watchdog mode) -->
                    <Grid Margin="0 0 0 15" 
                          IsEnabled="{Binding ProcessFilterMode, Converter={StaticResource EnumToBoolConverter}, ConverterParameter=2}"
                          Visibility="{Binding WatchdogMode, Converter={StaticResource InverseBoolToVisibilityConverter}}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="200"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Text="Select which apps to show:" Foreground="{StaticResource TextPrimary}" FontSize="13" FontWeight="SemiBold" Margin="0 0 0 6"/>
                        <TextBlock Grid.Row="1" Text="Pick from running processes on the left, your selected apps appear on the right" Foreground="{StaticResource TextSecondary}" FontSize="11" Margin="0 0 0 10"/>

                        <Grid Grid.Row="2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" Background="{StaticResource BackgroundSecondary}" BorderBrush="{StaticResource BackgroundCard}" BorderThickness="1">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>
                                    <TextBlock Text="Running Apps" Foreground="{StaticResource TextSecondary}" FontSize="11" Margin="8 6" Grid.Row="0"/>
                                    <TextBox Grid.Row="1"
                                             Text="{Binding SelectedProcessSearch, UpdateSourceTrigger=PropertyChanged}"
                                             Background="{StaticResource BackgroundCard}"
                                             Foreground="{StaticResource TextPrimary}"
                                             BorderBrush="{StaticResource BackgroundCard}"
                                             Margin="6 0 6 6"
                                             Padding="6 4"
                                             FontSize="11"
                                             ToolTip="Search running apps"/>
                                    <ListBox Grid.Row="2"
                                             ItemsSource="{Binding AvailableForSelection}"
                                             SelectedItem="{Binding SelectedAvailableProcess}"
                                             Background="Transparent"
                                             Foreground="{StaticResource TextPrimary}"
                                             BorderThickness="0"
                                             Margin="4 0 4 4">
                                        <ListBox.InputBindings>
                                            <KeyBinding Key="Enter" Command="{Binding AddSelectedProcessCommand}"/>
                                        </ListBox.InputBindings>
                                    </ListBox>
                                </Grid>
                            </Border>

                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="10 0">
                                <Button Content="Add &gt;" Command="{Binding AddSelectedProcessCommand}" Style="{StaticResource SmallActionButton}" Margin="0 0 0 8" Height="32" Width="90"/>
                                <Button Content="&lt; Remove" Command="{Binding RemoveSelectedProcessCommand}" Style="{StaticResource SmallActionButton}" Height="32" Width="90"/>
                            </StackPanel>

                            <Border Grid.Column="2" Background="{StaticResource BackgroundSecondary}" BorderBrush="{StaticResource BackgroundCard}" BorderThickness="1">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>
                                    <TextBlock Text="Selected to Show" Foreground="{DynamicResource AccentBrush}" FontSize="11" Margin="8 6" Grid.Row="0" FontWeight="SemiBold"/>
                                    <ListBox Grid.Row="1"
                                             ItemsSource="{Binding SelectedProcesses}"
                                             SelectedItem="{Binding SelectedProcessToRemove}"
                                             Background="Transparent"
                                             Foreground="{StaticResource TextPrimary}"
                                             BorderThickness="0"
                                             Margin="4 0 4 4">
                                        <ListBox.Resources>
                                            <Style TargetType="ListBoxItem">
                                                <Setter Property="Background" Value="Transparent"/>
                                                <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
                                                <Style.Triggers>
                                                    <Trigger Property="IsSelected" Value="True">
                                                        <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
                                                        <Setter Property="Foreground" Value="White"/>
                                                    </Trigger>
                                                </Style.Triggers>
                                            </Style>
                                        </ListBox.Resources>
                                        <ListBox.InputBindings>
                                            <KeyBinding Key="Enter" Command="{Binding RemoveSelectedProcessCommand}"/>
                                        </ListBox.InputBindings>
                                    </ListBox>
                                </Grid>
                            </Border>
                        </Grid>

                        <TextBlock Grid.Row="3" Text="Tip: Only apps in 'Selected to Show' will appear in the Currently Running table" Foreground="{StaticResource TextSecondary}" FontSize="10" FontStyle="Italic" Margin="0 8 0 0"/>
                    </Grid>

                    <Separator Margin="0 15 0 15"/>

                    <!-- Developer & System Maintenance -->
                    <TextBlock Text="Developer &amp; System Maintenance"
                               FontSize="18" FontWeight="SemiBold"
                               Foreground="{StaticResource TextPrimary}" Margin="0 0 0 8"/>
                    <TextBlock Text="Reset all runtime data stored in AppData (logs, cache, sessions) to restore TaskCore to a clean first-run state."
                               FontSize="11" Foreground="{StaticResource TextSecondary}"
                               TextWrapping="Wrap" Margin="0 0 0 12"/>
                    <Button Content="Reset Application Data"
                            Command="{Binding ResetApplicationDataCommand}"
                            HorizontalAlignment="Left"
                            Padding="14 8" Background="#FFD32F2F" Foreground="White"
                            BorderThickness="0" FontWeight="SemiBold"/>

                </StackPanel>
            </ScrollViewer>

        </Border>

    </Grid>

</UserControl>
