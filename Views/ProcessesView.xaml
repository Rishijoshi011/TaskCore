<UserControl x:Class="TaskCore.Views.ProcessesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:converters="clr-namespace:TaskCore.Converters"
             xmlns:vm="clr-namespace:TaskCore.ViewModels"
             mc:Ignorable="d"
             Background="{StaticResource BackgroundPrimary}">

    <UserControl.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
        <converters:BoolToArrowConverter x:Key="BoolToArrowConverter"/>
        <converters:NullToBoolConverter x:Key="NullToBoolConverter"/>
    </UserControl.Resources>

    <UserControl.DataContext>
        <vm:ProcessesViewModel/>
    </UserControl.DataContext>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- Title -->
            <RowDefinition Height="Auto"/>
            <!-- Search bar -->
            <RowDefinition Height="Auto"/>
            <!-- Header row -->
            <RowDefinition Height="*"/>
            <!-- List -->
            <RowDefinition Height="Auto"/>
            <!-- End task -->
        </Grid.RowDefinitions>

        <!-- TITLE -->
        <TextBlock Text="Processes"
                   Grid.Row="0"
                   FontSize="26"
                   FontWeight="Bold"
                   Foreground="{StaticResource AccentBrush}"
                   Margin="0 0 0 20"/>

        <!-- SEARCH + FILTER -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0 0 0 20">
            <TextBox Width="240"
                     Height="32"
                     Padding="6"
                     Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}"
                     Background="{StaticResource BackgroundSecondary}"
                     Foreground="{StaticResource TextPrimary}"
                     BorderBrush="{StaticResource AccentBrush}"
                     VerticalContentAlignment="Center"/>

            <ComboBox Width="160" Height="32" Margin="10 0 0 0"
                      SelectedValue="{Binding MemoryFilter}"
                      SelectedValuePath="Tag">

                <ComboBoxItem Content="All Memory" Tag="0"/>
                <ComboBoxItem Content="> 100 MB" Tag="100"/>
                <ComboBoxItem Content="> 250 MB" Tag="250"/>
                <ComboBoxItem Content="> 500 MB" Tag="500"/>
                <ComboBoxItem Content="> 1 GB" Tag="1024"/>
            </ComboBox>
        </StackPanel>

        <!-- COLUMNS HEADER -->
        <Grid Grid.Row="2" Margin="0 0 0 6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="24"/>
                <!-- icon -->
                <ColumnDefinition Width="*"/>
                <!-- name -->
                <ColumnDefinition Width="90"/>
                <!-- CPU -->
                <ColumnDefinition Width="110"/>
                <!-- Memory -->
                <ColumnDefinition Width="120"/>
                <!-- PID -->
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="1" Text="Name" Foreground="{StaticResource TextSecondary}" FontWeight="SemiBold"/>
            <TextBlock Grid.Column="2" Text="CPU" Foreground="{StaticResource TextSecondary}" FontWeight="SemiBold"/>
            <TextBlock Grid.Column="3" Text="Memory" Foreground="{StaticResource TextSecondary}" FontWeight="SemiBold"/>
            <TextBlock Grid.Column="4" Text="PID" Foreground="{StaticResource TextSecondary}" FontWeight="SemiBold"/>
        </Grid>

        <!-- PROCESS LIST -->
        <Border Grid.Row="3" Padding="4">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding ProcessGroups}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="0 0 0 6">

                                <!-- GROUP HEADER -->
                                <Border Background="{StaticResource BackgroundSecondary}"
                                        Padding="10"
                                        CornerRadius="4"
                                        MouseLeftButtonDown="GroupHeader_Click">

                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="24"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="90"/>
                                            <ColumnDefinition Width="110"/>
                                            <ColumnDefinition Width="120"/>
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Text="{Binding IsExpanded, Converter={StaticResource BoolToArrowConverter}}"
                                                   Foreground="{StaticResource AccentBrush}"
                                                   FontSize="14"/>

                                        <TextBlock Grid.Column="1" Text="{Binding GroupName}"
                                                   Foreground="{StaticResource TextPrimary}" FontWeight="Bold"/>

                                        <TextBlock Grid.Column="2" Text="{Binding TotalCpu, StringFormat={}{0}%}"
                                                   Foreground="{StaticResource TextSecondary}"/>

                                        <TextBlock Grid.Column="3" Text="{Binding TotalMemory, StringFormat={}{0} MB}"
                                                   Foreground="{StaticResource TextSecondary}"/>

                                        <TextBlock Grid.Column="4" Text="{Binding Items[0].PID}"
                                                   Foreground="{StaticResource TextSecondary}"/>
                                    </Grid>
                                </Border>

                                <!-- CHILD PROCESSES -->
                                <ItemsControl ItemsSource="{Binding Items}">
                                    <ItemsControl.Style>
                                        <Style TargetType="ItemsControl">
                                            <Setter Property="Visibility"
                                                    Value="{Binding IsExpanded, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                        </Style>
                                    </ItemsControl.Style>

                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>

                                            <Border Background="{StaticResource BackgroundPrimary}"
                                                    CornerRadius="4"
                                                    Padding="8"
                                                    Margin="0 2 0 0"
                                                    MouseLeftButtonDown="ProcessRow_Click">

                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="24"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="90"/>
                                                        <ColumnDefinition Width="110"/>
                                                        <ColumnDefinition Width="120"/>
                                                    </Grid.ColumnDefinitions>

                                                    <TextBlock/>

                                                    <TextBlock Grid.Column="1" Text="{Binding Name}"
                                                               Foreground="{StaticResource TextPrimary}"/>

                                                    <TextBlock Grid.Column="2" Text="{Binding CpuUsage, StringFormat={}{0}%}"
                                                               Foreground="{StaticResource TextSecondary}"/>

                                                    <TextBlock Grid.Column="3" Text="{Binding MemoryMB, StringFormat={}{0} MB}"
                                                               Foreground="{StaticResource TextSecondary}"/>

                                                    <TextBlock Grid.Column="4" Text="{Binding PID}"
                                                               Foreground="{StaticResource TextSecondary}"/>
                                                </Grid>
                                            </Border>

                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>

        <!-- END TASK -->
        <Button Grid.Row="4"
                Content="End Task"
                Width="130"
                Padding="12 6"
                FontWeight="Bold"
                HorizontalAlignment="Right"
                Command="{Binding EndTaskCommand}"
                Margin="0 20 0 0"/>

        <!-- 🔄 LOADING OVERLAY -->
        <Grid Grid.RowSpan="5"
          Background="#33000000"
          Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibilityConverter}}"
          Panel.ZIndex="999">

            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <ProgressBar Width="140"
                     Height="10"
                     IsIndeterminate="True"
                     Foreground="{StaticResource AccentBrush}"/>

                <TextBlock Text="Loading..."
                   Foreground="{StaticResource TextSecondary}"
                   Margin="0 8 0 0"
                   HorizontalAlignment="Center"/>
            </StackPanel>

        </Grid>


    </Grid>
</UserControl>
