<UserControl x:Class="TaskCore.Views.ProcessesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:converters="clr-namespace:TaskCore.Converters"
             xmlns:vm="clr-namespace:TaskCore.ViewModels"
             mc:Ignorable="d"
             Background="{StaticResource BackgroundPrimary}">

    <UserControl.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
        <converters:BoolToArrowConverter x:Key="BoolToArrowConverter"/>
        <converters:NullToBoolConverter x:Key="NullToBoolConverter"/>
    </UserControl.Resources>

    <UserControl.DataContext>
        <vm:ProcessesViewModel/>
    </UserControl.DataContext>

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- Title -->
            <RowDefinition Height="Auto"/>
            <!-- Search bar -->
            <RowDefinition Height="Auto"/>
            <!-- Header row -->
            <RowDefinition Height="*"/>
            <!-- List -->
            <RowDefinition Height="Auto"/>
            <!-- End task -->
        </Grid.RowDefinitions>

        <!-- TITLE -->
        <TextBlock Text="Processes"
                   Grid.Row="0"
                   FontSize="28"
                   FontWeight="Bold"
                   Foreground="{StaticResource AccentBrush}"
                   Margin="0 0 0 30"/>

        <!-- SEARCH + FILTER -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0 0 0 30">
            <TextBox Width="260"
                     Height="36"
                     Padding="8,8"
                     Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}"
                     Background="{StaticResource BackgroundSecondary}"
                     Foreground="{StaticResource TextPrimary}"
                     BorderBrush="{StaticResource AccentBrush}"
                     VerticalContentAlignment="Center"/>

            <ComboBox Width="160" Height="32" Margin="10 0 0 0"
                      SelectedValue="{Binding MemoryFilter}"
                      SelectedValuePath="Tag">

                <ComboBoxItem Content="All Memory" Tag="0"/>
                <ComboBoxItem Content="&gt; 100 MB" Tag="100"/>
                <ComboBoxItem Content="&gt; 250 MB" Tag="250"/>
                <ComboBoxItem Content="&gt; 500 MB" Tag="500"/>
                <ComboBoxItem Content="&gt; 1 GB" Tag="1024"/>
            </ComboBox>
            
            <Control Style="{StaticResource InfoIcon}" Margin="8 0 0 0" VerticalAlignment="Center"
                    ToolTip="Filter processes by memory usage.&#10;Shows only processes using more than the selected amount of RAM."/>
        </StackPanel>

        <!-- COLUMNS HEADER -->
        <Grid Grid.Row="2" Margin="0 0 0 6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="24"/>
                <!-- expand/indent -->
                <ColumnDefinition Width="24"/>
                <!-- icon -->
                <ColumnDefinition Width="*"/>
                <!-- name -->
                <ColumnDefinition Width="90"/>
                <!-- CPU -->
                <ColumnDefinition Width="110"/>
                <!-- Memory -->
                <ColumnDefinition Width="120"/>
                <!-- PID -->
            </Grid.ColumnDefinitions>

            <Button Grid.Column="2"
                    Command="{Binding SortByCommand}"
                    CommandParameter="Name"
                    Background="Transparent"
                    BorderThickness="0"
                    Padding="0"
                    HorizontalContentAlignment="Left">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Name" Foreground="{StaticResource TextSecondary}" FontWeight="SemiBold"/>
                    <TextBlock Margin="4 0 0 0" Text="{Binding NameSortIndicator}" Foreground="{StaticResource TextSecondary}" FontWeight="SemiBold"/>
                </StackPanel>
            </Button>

            <Button Grid.Column="3"
                    Command="{Binding SortByCommand}"
                    CommandParameter="Cpu"
                    Background="Transparent"
                    BorderThickness="0"
                    Padding="0"
                    HorizontalContentAlignment="Right">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <TextBlock Text="CPU" Foreground="{StaticResource TextSecondary}" FontWeight="SemiBold"/>
                    <TextBlock Margin="4 0 0 0" Text="{Binding CpuSortIndicator}" Foreground="{StaticResource TextSecondary}" FontWeight="SemiBold"/>
                </StackPanel>
            </Button>

            <Button Grid.Column="4"
                    Command="{Binding SortByCommand}"
                    CommandParameter="Memory"
                    Background="Transparent"
                    BorderThickness="0"
                    Padding="0"
                    HorizontalContentAlignment="Right">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <TextBlock Text="Memory" Foreground="{StaticResource TextSecondary}" FontWeight="SemiBold"/>
                    <TextBlock Margin="4 0 0 0" Text="{Binding MemorySortIndicator}" Foreground="{StaticResource TextSecondary}" FontWeight="SemiBold"/>
                </StackPanel>
            </Button>

            <Button Grid.Column="5"
                    Command="{Binding SortByCommand}"
                    CommandParameter="Pid"
                    Background="Transparent"
                    BorderThickness="0"
                    Padding="0"
                    HorizontalContentAlignment="Right">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <TextBlock Text="PID" Foreground="{StaticResource TextSecondary}" FontWeight="SemiBold"/>
                    <TextBlock Margin="4 0 0 0" Text="{Binding PidSortIndicator}" Foreground="{StaticResource TextSecondary}" FontWeight="SemiBold"/>
                </StackPanel>
            </Button>
        </Grid>

        <!-- PROCESS LIST -->
        <Border Grid.Row="3" Padding="4">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding ProcessGroups}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="0 0 0 6">

                                <!-- GROUP HEADER -->
                                <Button Command="{Binding DataContext.SelectGroupCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}"
                                        Background="{StaticResource BackgroundSecondary}"
                                        Foreground="{StaticResource TextPrimary}"
                                        BorderThickness="0"
                                        Padding="10"
                                        Margin="0 0 0 2"
                                        HorizontalContentAlignment="Stretch">

                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                            <Setter Property="Background" Value="{StaticResource BackgroundSecondary}"/>
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border Background="{TemplateBinding Background}"
                                                                CornerRadius="4"
                                                                Padding="{TemplateBinding Padding}">
                                                            <ContentPresenter HorizontalAlignment="Stretch"/>
                                                        </Border>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                            <Style.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Background" Value="#4A4A4A"/>
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>

                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="24"/>
                                            <ColumnDefinition Width="24"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="90"/>
                                            <ColumnDefinition Width="110"/>
                                            <ColumnDefinition Width="120"/>
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Text="{Binding IsExpanded, Converter={StaticResource BoolToArrowConverter}}"
                                                   Foreground="{StaticResource AccentBrush}"
                                                   FontSize="14"
                                                   VerticalAlignment="Center"/>

                                        <Image Grid.Column="1" 
                                               Source="{Binding Icon}" 
                                               Width="16" 
                                               Height="16"
                                               Stretch="Uniform"
                                               VerticalAlignment="Center"
                                               HorizontalAlignment="Center"/>

                                        <TextBlock Grid.Column="2" Text="{Binding GroupName}"
                                                   Foreground="{StaticResource TextPrimary}" FontWeight="Bold"
                                                   VerticalAlignment="Center"/>

                                        <TextBlock Grid.Column="3" Text="{Binding TotalCpu, StringFormat={}{0}%}"
                                                   Foreground="{StaticResource TextSecondary}"
                                                   VerticalAlignment="Center"
                                                   TextAlignment="Right"/>

                                        <TextBlock Grid.Column="4" Text="{Binding TotalMemory, StringFormat={}{0} MB}"
                                                   Foreground="{StaticResource TextSecondary}"
                                                   VerticalAlignment="Center"
                                                   TextAlignment="Right"/>

                                        <TextBlock Grid.Column="5" Text="{Binding Items[0].PID}"
                                                   Foreground="{StaticResource TextSecondary}"
                                                   VerticalAlignment="Center"
                                                   TextAlignment="Right"/>
                                    </Grid>
                                </Button>

                                <!-- CHILD PROCESSES -->
                                <ItemsControl ItemsSource="{Binding Items}">
                                    <ItemsControl.Style>
                                        <Style TargetType="ItemsControl">
                                            <Setter Property="Visibility"
                                                    Value="{Binding IsExpanded, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                        </Style>
                                    </ItemsControl.Style>

                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>

                                            <Button Command="{Binding DataContext.SelectProcessCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}"
                                                    Background="{StaticResource BackgroundPrimary}"
                                                    Foreground="{StaticResource TextPrimary}"
                                                    BorderThickness="0"
                                                    Padding="8"
                                                    Margin="0 2 0 0"
                                                    HorizontalContentAlignment="Stretch">

                                                <Button.Style>
                                                    <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                                        <Setter Property="Background" Value="{StaticResource BackgroundPrimary}"/>
                                                        <Setter Property="Template">
                                                            <Setter.Value>
                                                                <ControlTemplate TargetType="Button">
                                                                    <Border Background="{TemplateBinding Background}"
                                                                            CornerRadius="4"
                                                                            Padding="{TemplateBinding Padding}">
                                                                        <ContentPresenter HorizontalAlignment="Stretch"/>
                                                                    </Border>
                                                                </ControlTemplate>
                                                            </Setter.Value>
                                                        </Setter>
                                                        <Style.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter Property="Background" Value="#3A3A3A"/>
                                                            </Trigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Button.Style>

                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="24"/>
                                                        <!-- indent to align with group expand arrow -->
                                                        <ColumnDefinition Width="24"/>
                                                        <!-- icon -->
                                                        <ColumnDefinition Width="*"/>
                                                        <!-- name -->
                                                        <ColumnDefinition Width="90"/>
                                                        <!-- CPU -->
                                                        <ColumnDefinition Width="110"/>
                                                        <!-- Memory -->
                                                        <ColumnDefinition Width="120"/>
                                                        <!-- PID -->
                                                    </Grid.ColumnDefinitions>

                                                    <Image Grid.Column="1" 
                                                           Source="{Binding Icon}" 
                                                           Width="16" 
                                                           Height="16"
                                                           Stretch="Uniform"
                                                           VerticalAlignment="Center"
                                                           HorizontalAlignment="Center"/>

                                                    <TextBlock Grid.Column="2" Text="{Binding Name}"
                                                               Foreground="{StaticResource TextPrimary}"
                                                               VerticalAlignment="Center"/>

                                                    <TextBlock Grid.Column="3" Text="{Binding CpuUsage, StringFormat={}{0}%}"
                                                               Foreground="{StaticResource TextSecondary}"
                                                               TextAlignment="Right"/>

                                                    <TextBlock Grid.Column="4" Text="{Binding MemoryMB, StringFormat={}{0} MB}"
                                                               Foreground="{StaticResource TextSecondary}"
                                                               TextAlignment="Right"/>

                                                    <TextBlock Grid.Column="5" Text="{Binding PID}"
                                                               Foreground="{StaticResource TextSecondary}"
                                                               TextAlignment="Right"/>
                                                </Grid>
                                            </Button>

                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>

        <!-- END TASK -->
        <Button Grid.Row="4"
                Content="End Task"
                Width="130"
                Padding="12 6"
                FontWeight="Bold"
                HorizontalAlignment="Right"
                Command="{Binding EndTaskCommand}"
                Margin="0 20 0 0"/>

        <!-- 🔄 LOADING OVERLAY -->
        <Grid Grid.RowSpan="5"
          Background="#33000000"
          Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibilityConverter}}"
          Panel.ZIndex="999">

            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <ProgressBar Width="140"
                     Height="10"
                     IsIndeterminate="True"
                     Foreground="{StaticResource AccentBrush}"/>

                <TextBlock Text="Loading..."
                   Foreground="{StaticResource TextSecondary}"
                   Margin="0 8 0 0"
                   HorizontalAlignment="Center"/>
            </StackPanel>

        </Grid>


    </Grid>
</UserControl>
