<Window x:Class="TaskCore.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:views="clr-namespace:TaskCore.Views"
        mc:Ignorable="d"
        Title="TaskCore"
        WindowStyle="None"
        ResizeMode="CanResize"
        Background="{StaticResource BackgroundPrimary}"
        Width="1200"
        Height="750">

    <Border Background="{StaticResource BackgroundPrimary}">
        <Grid>

            <!-- ================= TOP BAR ================= -->
            <Grid Background="{StaticResource BackgroundSecondary}" Height="40" VerticalAlignment="Top">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- DRAG AREA + TITLE -->
                <Grid Grid.Column="0" MouseDown="DragWindow"
                      VerticalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    
                    <!-- Hamburger Menu Button -->
                    <Button x:Name="HamburgerButton" 
                            Grid.Column="0"
                            Background="Transparent" 
                            BorderThickness="0"
                            Padding="8,6"
                            Click="ToggleSidebar"
                            VerticalAlignment="Center"
                            Margin="8,0,12,0">
                        <TextBlock Text="☰" 
                                   Foreground="{StaticResource TextPrimary}"
                                   FontSize="16" 
                                   HorizontalAlignment="Center" 
                                   VerticalAlignment="Center"/>
                    </Button>
                    
                    <!-- TaskCore Title -->
                    <TextBlock Text="TaskCore"
                               Grid.Column="1"
                               Foreground="{StaticResource AccentBrush}"
                               FontSize="16"
                               FontWeight="Medium"
                               VerticalAlignment="Center"/>
                </Grid>

                <!-- WINDOW BUTTONS -->
                <StackPanel Grid.Column="1" Orientation="Horizontal">

                    <!-- Minimize -->
                    <Button Width="46" Height="40" Background="Transparent" 
                           Click="Minimize_Click"
                           Style="{x:Null}">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="border" Background="Transparent">
                                    <TextBlock Text="−" 
                                               Foreground="{StaticResource TextPrimary}"
                                               FontSize="16" 
                                               HorizontalAlignment="Center" 
                                               VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="border" Property="Background" Value="#444444"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                    
                    <!-- Maximize -->
                    <Button Width="46" Height="40" Background="Transparent" 
                           Click="Maximize_Click"
                           Style="{x:Null}">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="border" Background="Transparent">
                                    <TextBlock Text="▢"
                                               Foreground="{StaticResource TextPrimary}"
                                               FontSize="14"
                                               HorizontalAlignment="Center" 
                                               VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="border" Property="Background" Value="#444444"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>

                    <!-- Close -->
                    <Button Width="46" Height="40" Background="Transparent" 
                           Click="Close_Click"
                           Style="{x:Null}">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="border" Background="Transparent">
                                    <TextBlock Text="×"
                                               Foreground="{StaticResource TextPrimary}"
                                               FontSize="18" 
                                               HorizontalAlignment="Center" 
                                               VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="border" Property="Background" Value="#E81123"/>
                                        <Setter Property="TextBlock.Foreground" Value="White" TargetName="border"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                    
                </StackPanel>
            </Grid>


            <!-- ================= MAIN LAYOUT ================= -->
            <Grid Margin="0,40,0,0">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition x:Name="SidebarColumn" Width="220"/>
                    <!-- SIDEBAR -->
                    <ColumnDefinition Width="*"/>
                    <!-- CONTENT -->
                </Grid.ColumnDefinitions>

                <!-- ************ SIDEBAR ************ -->
                <Border x:Name="SidebarBorder"
                        Grid.Column="0"
                        Background="{StaticResource BackgroundSecondary}"
                        Padding="20 25">

                    <StackPanel>

                        <!-- APP TITLE -->
                        <!-- <TextBlock Text="TaskCore"
                                   FontSize="24"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource AccentBrush}"
                                   Margin="0 0 0 30"
                                   HorizontalAlignment="Center"/> -->

                        <!-- NAV MENU -->
                        <ListBox x:Name="Sidebar"
                                 SelectionChanged="Sidebar_SelectionChanged"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 Foreground="{StaticResource TextPrimary}"
                                 FontSize="14">

                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="Margin" Value="0 3"/>
                                    <Setter Property="Padding" Value="12 10"/>
                                    <Setter Property="Cursor" Value="Hand"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListBoxItem">
                                                <Border x:Name="bd"
                                                        Background="Transparent"
                                                        CornerRadius="8"
                                                        Padding="{TemplateBinding Padding}">
                                                    <ContentPresenter />
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="bd" Property="Background"
                                                                Value="#3A3A3A"/>
                                                    </Trigger>
                                                    <Trigger Property="IsSelected" Value="True">
                                                        <Setter TargetName="bd" Property="Background"
                                                                Value="#5A5A5A"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListBox.ItemContainerStyle>

                            <!-- SIDEBAR ITEMS -->
                            <ListBoxItem>
                                <StackPanel Orientation="Horizontal">
                                    <Image Source="pack://application:,,,/TaskCore;component/Resources/Icons/Processes.png"
                                           Width="18" Height="18" Margin="0 0 12 0"/>
                                    <TextBlock Text="Processes" FontWeight="Medium"/>
                                </StackPanel>
                            </ListBoxItem>

                            <ListBoxItem>
                                <StackPanel Orientation="Horizontal">
                                    <Image Source="pack://application:,,,/TaskCore;component/Resources/Icons/Graphs.png"
                                           Width="18" Height="18" Margin="0 0 12 0"/>
                                    <TextBlock Text="Graphs" FontWeight="Medium"/>
                                </StackPanel>
                            </ListBoxItem>

                            <ListBoxItem>
                                <StackPanel Orientation="Horizontal">
                                    <Image Source="pack://application:,,,/TaskCore;component/Resources/Icons/Details.png"
                                           Width="18" Height="18" Margin="0 0 12 0"/>
                                    <TextBlock Text="Details" FontWeight="Medium"/>
                                </StackPanel>
                            </ListBoxItem>

                            <ListBoxItem>
                                <StackPanel Orientation="Horizontal">
                                    <Image Source="pack://application:,,,/TaskCore;component/Resources/Icons/Settings.png"
                                           Width="18" Height="18" Margin="0 0 12 0"/>
                                    <TextBlock Text="Settings" FontWeight="Medium"/>
                                </StackPanel>
                            </ListBoxItem>

                        </ListBox>

                    </StackPanel>
                </Border>



                <!-- ************ CONTENT AREA ************ -->
                <ContentControl x:Name="ContentArea"
                                Grid.Column="1"
                                Margin="20"/>
            </Grid>

        </Grid>
    </Border>
</Window>
