<Window x:Class="TaskCore.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:TaskCore"
        Title="TaskCore" Height="700" Width="1100"
        Background="#353545"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <local:SidebarWidthConverter x:Key="SidebarWidthConverter"/>
        <!-- sidebar button style -->
        <Style x:Key="SidebarButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#b8c0cc"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="Margin" Value="12,0,0,0"/>
            <Setter Property="HorizontalContentAlignment" Value="Right"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="6" Margin="0,6"> <!-- Spacing between buttons -->
                            <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value> 
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#750889ad"/> <!-- Less transparent hover -->
                    <Setter Property="Foreground" Value="#1E1E23"/>
                    <Setter Property="FontWeight" Value="Bold"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Foreground" Value="#444c56"/>
                    <Setter Property="Background" Value="#1E1E23"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="{Binding IsSidebarOpen, Converter={StaticResource SidebarWidthConverter}}"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <!-- Sidebar -->
        <StackPanel Grid.Column="0" Background="#1E1E23" VerticalAlignment="Stretch">
            <!-- Icon and App Name -->
            <StackPanel Orientation="Horizontal" Margin="8,24,0,24" VerticalAlignment="Center">
                <Button x:Name="HamburgerButton"
                        Width="40" Height="40"
                        Margin="0 8 8 8"
                        VerticalAlignment="Top"
                        HorizontalAlignment="Left"
                        Background="Transparent"
                        BorderThickness="0"
                        Click="HamburgerButton_Click"
                        ToolTip="Toggle Menu"
                        Panel.ZIndex="100"
                        Grid.ColumnSpan="2">
                    <Viewbox Width="28" Height="28">
                        <Canvas Width="24" Height="24">
                            <Path Data="M4,12 L10,6 M4,12 L10,18" Stroke="Transparent" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                            <Path Data="M20,12 L14,6 M20,12 L14,18" Stroke="Transparent" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                        </Canvas>
                    </Viewbox>
                </Button>
                <TextBlock Text="TaskCore"
                           FontSize="22"
                           FontWeight="Bold"
                           Foreground="#e0e0e0"
                           VerticalAlignment="Center"
                           Visibility="{Binding IsSidebarOpen, Converter={StaticResource BoolToVis}}"
                           Margin="0,0,0,0"/>
            </StackPanel>
            <Separator Margin="0,0,0,8"/>
            <Button Style="{StaticResource SidebarButtonStyle}" Click="ProcessListButton_Click">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="📝" FontSize="18"/> 
                    <TextBlock Text="  Process List" Margin="8,0,0,0" FontSize="18" Visibility="{Binding IsSidebarOpen, Converter={StaticResource BoolToVis}}"/>
                </StackPanel>
            </Button>
            <Button Style="{StaticResource SidebarButtonStyle}" Click="SystemGraphsButton_Click">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="📊" FontSize="18"/>
                    <TextBlock Text="  System Graphs" Margin="8,0,0,0" FontSize="18" Visibility="{Binding IsSidebarOpen, Converter={StaticResource BoolToVis}}"/>
                </StackPanel>
            </Button>
            <Button Style="{StaticResource SidebarButtonStyle}" IsEnabled="False">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="🧹" FontSize="18"/>
                    <TextBlock Text="  RAM Cleanup" Margin="8,0,0,0" FontSize="18" Visibility="{Binding IsSidebarOpen, Converter={StaticResource BoolToVis}}"/>
                </StackPanel>
            </Button>
            <Button Style="{StaticResource SidebarButtonStyle}" Click="WatchDogButton_Click">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="🔔" FontSize="18"/>
                    <TextBlock Text="  Watchdog" Margin="8,0,0,0" FontSize="18" Visibility="{Binding IsSidebarOpen, Converter={StaticResource BoolToVis}}"/>
                </StackPanel>
            </Button>
        </StackPanel>
        <!-- Main Content -->
        <Grid Grid.Column="1" Margin="16">
            <ContentControl Content="{Binding CurrentPanelView}" />

        </Grid>
    </Grid>
</Window>