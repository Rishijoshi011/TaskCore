<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
  </PropertyGroup>

  <ItemGroup>
    <None Remove="Resources\Icons\Details.png" />
    <None Remove="Resources\Icons\Graphs.png" />
    <None Remove="Resources\Icons\Processes.png" />
    <None Remove="Resources\Icons\Settings.png" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0" />
    <PackageReference Include="LiveChartsCore" Version="2.0.0-rc6.1" />
    <PackageReference Include="LiveChartsCore.SkiaSharpView.WPF" Version="2.0.0-rc6.1" />
    <PackageReference Include="Microsoft.VisualBasic" Version="10.3.0" />
  </ItemGroup>

  <ItemGroup>
    <Page Update="Resources\Theme.xaml">
      <Generator></Generator>
    </Page>
    <Page Update="Views\DetailsView.xaml">
      <Generator></Generator>
    </Page>
    <Page Update="Views\GraphsView.xaml">
      <Generator></Generator>
    </Page>
    <Page Update="Views\Graphs\CpuGraphView.xaml">
      <Generator></Generator>
    </Page>
    <Page Update="Views\Graphs\DiskGraphView.xaml">
      <Generator></Generator>
    </Page>
    <Page Update="Views\Graphs\GpuGraphView.xaml">
      <Generator></Generator>
    </Page>
    <Page Update="Views\Graphs\MemoryGraphView.xaml">
      <Generator></Generator>
    </Page>
    <Page Update="Views\Graphs\NetworkGraphView.xaml">
      <Generator></Generator>
    </Page>
    <Page Update="Views\ProcessesView.xaml">
      <Generator></Generator>
    </Page>
    <Page Update="Views\SettingsView.xaml">
      <Generator></Generator>
    </Page>
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Resources\Icons\Details.png" />
    <Resource Include="Resources\Icons\Graphs.png" />
    <Resource Include="Resources\Icons\Processes.png" />
    <Resource Include="Resources\Icons\Settings.png" />
  </ItemGroup>

</Project>
